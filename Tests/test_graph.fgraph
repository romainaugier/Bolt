  {
    "name": "Hou_LoadAlembic",
    "id": "3538626164316366396636643531373236313466656132323765353332623166",
    "color": [
      255,
      87,
      34
    ],
    "inputCount": 1,
    "outputCount": 1,
    "opCode": "# BeginOp\n\ngeneratedScript = f\"\"\"import hou, os\n\nfilename = os.path.splitext(os.path.basename(\"{input0}\"))[0]\nfilepath = \"{input0}\"\n\nif \"{file}\" != \"\" and os.path.exists(\"{file}\"):\n    hou.hipFile.load(\"{file}\")\n\nsopNode = hou.node(\"/obj\").createNode(\"geo\", \"alembic_{{}}\".format(filename))\n\nabcNode = sopNode.createNode(\"alembic\")\nabcNode.parm(\"fileName\").set(filepath)\nabcNode.parm(\"loadmode\").set(1)\n\nconvertNode = sopNode.createNode(\"convert\")\nconvertNode.setInput(0, abcNode)\n\nxformNode = sopNode.createNode(\"xform\")\nxformNode.setInput(0, convertNode)\n\nnullNode = sopNode.createNode(\"null\", \"OUT_{{}}\".format(filename))\nnullNode.setInput(0, xformNode)\n\nsopNode.layoutChildren()\n\nif file != \"\":\n    hou.hipFile.save(\"{file}\")\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutput0 = tmpScriptFilePath.replace(\"\\\\\", \"/\")\n\n",
    "inputs": {
      "input0": {
        "connectionIndex": 0,
        "connectionNodeId": "3962393032336364613839316665636364656331633930623038646639623064"
      }
    },
