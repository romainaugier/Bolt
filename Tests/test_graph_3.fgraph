  {
    "name": "Hou_Auto_Plume",
    "id": "3462353738653032623133303538336436623933643234376135663237303666",
    "color": [
      255,
      87,
      34
    ],
    "inputCount": 2,
    "outputCount": 1,
    "opCode": "# BeginOp\n\ngeneratedScript = f\"\"\"import hou\n\nhou.hipFile.load(\"{input1}\")\n\nanimSopNode = None\nplumeSopNode = None\n\nfor node in hou.node(\"/obj\").children():\n    if node.name() == \"anim_import\":\n        animSopNode = node\n    elif node.name() == \"plume\":\n        plumeSopNode = node\n\nif animSopNode != None:\n    for node in animSopNode.children():\n        if node.type().name() == \"alembic\":\n            node.parm(\"fileName\").set(\"{input0}\")\n            break\n\nif plumeSopNode != None:\n    for node in plumeSopNode.children():\n        if node.type().name() == \"rop_alembic\":\n            node.parm(\"filename\").set(\"{outfilepath}\")\n            node.parm(\"f1\").set({framerange[0]})\n            node.parm(\"f2\").set({framerange[1]})\n            node.parm(\"execute\").pressButton()\n\"\"\"\n\ntmpScriptFilePath = BoltTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutput0 = tmpScriptFilePath.replace(\"\\\\\", \"/\")\n\n",
    "inputs": {
      "input0": {
        "connectionIndex": 0,
        "connectionNodeId": "6332303664356262623939636166663461653663393234666366376264666337"
      },
