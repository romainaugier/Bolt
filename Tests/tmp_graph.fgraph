      "opCode": "# BeginOp\n\nimport subprocess\n\nFlashLogMessage(f\"Python : Start executing script : {inscript}\")\n\nprocess = subprocess.Popen([\"python\", inscript], stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    FlashLogError(stderrAsStr)\nelse:\n    FlashLogMessage(f\"Python : Finished executing script : {inscript}\")\n    FlashLogMessage(stdoutAsStr)\n\n",
