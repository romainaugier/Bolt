      "opCode": "# BeginOp\n\nimport subprocess, os\n\nFlashLogMessage(f\"NukeBatch : Start executing script : {inscript}\")\n\ncommand = [f\"{innukebindir}/nuke\", \"-x\", innukefile, \"-F\", f\"{inframerange[0]}-{inframerange[1]}\"]\n\nFlashLogMessage(f\"NukeBatch Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    FlashLogError(stderrAsStr)\nelse:\n    FlashLogMessage(f\"NukeBatch : Finished executing file : {innukefile}\")\n    FlashLogMessage(stdoutAsStr)\n\noutfile = innukefile\n\n",
