    {
      "name": "Guerilla_PrepareDeadlineJob1",
      "category": "Guerilla",
      "id": "6238373765383661353635623131383138316135373163643434623261316165",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/guerilla-render.png",
      "definitionPath": "$BOLT_LIB/Nodes/guerilla_prepare_deadline_job.bnode",
      "nodeType": "Guerilla/Guerilla_PrepareDeadlineJob",
      "opCode": "\nfrom datetime import datetime\nimport re, os, subprocess, platform, ast\n\nnow = datetime.now()\ncurrentTimeStr = now.strftime('%m%d%Y_%H%M%S')\n\n# Setup job and batch name\nteamName = inrenderoptions[\"Team\"]\njobType = inrenderoptions[\"Type\"]\nsequenceName = inrenderoptions[\"SequenceName\"] \nshotName = inrenderoptions[\"ShotName\"]\nframeRange = inrenderoptions[\"FrameRange\"]\n\njobName = f\"{teamName}_{jobType}_{sequenceName}_{shotName}\"\nbatchName = f\"{jobName}-{currentTimeStr}\"\n\nif jobType == \"LD\":\n    injoboptions[\"Priority\"] = 50\nelif jobType == \"FML\":\n    injoboptions[\"Priority\"] = 75\nelif jobType == \"HD\":\n    injoboptions[\"Priority\"] = 25\n\nrenderDir = f\"{inrenderdir}/{sequenceName}/{shotName}/{jobType}1\"\n\nwhile os.path.exists(renderDir):   \n    numPattern = r\"(\\d+)$\"\n\n    match = re.search(numPattern, renderDir)\n\n    value = int(match.group()) + 1\n\n    renderDir = f\"{renderDir[:match.start()]}{value}\"\n\nos.makedirs(renderDir)\nBoltLogMessage(f\"RenderDir : {renderDir}\")\n\nrenderFile = f\"{renderDir}/render_{sequenceName}_{shotName}_$f.$x\"\nopenExrIdFile = f\"{renderDir}/render_{sequenceName}_{shotName}_id_$f.$x\"\n\n# Setup job options\ninjoboptions[\"Plugin\"] = \"Guerilla\"\ninjoboptions[\"Name\"] = jobName\ninjoboptions[\"BatchName\"] = batchName\ninjoboptions[\"Frames\"] = frameRange\ninjoboptions[\"OutputDirectory0\"] = renderDir\n\n# Render Job Infos\ngeneratedRenderJobInfos = \"\"\n\nfor key, item in injoboptions.items():\n    generatedRenderJobInfos += f\"{key}={item}\\n\"\n\n# Ribgen Job Infos\ninjoboptions[\"Name\"] = f\"{jobName}_ribgen\"\ninjoboptions[\"Frames\"] = 0\n\ngeneratedRibgenJobInfos = \"\"\n\nfor key, item in injoboptions.items():\n    generatedRibgenJobInfos += f\"{key}={item}\\n\"\n\n# Generate Guerilla script\n\nboltTmpDir = BoltTempDir().replace(\"\\\\\", \"/\")\n\ngeneratedScript = f\"\"\"import guerilla, os, binascii\nimport RomanoTools.Guerilla.Utils as utils\n\nlayer = guerilla.Document().findchild(\"RenderPass|Layer\")\n\naovs = {inrenderpasses}\n\nexistingAovs = [aov.PlugName.get() for aov in layer.children()]\n\naovsToAdd = {inrenderpasses}\n\nfor aov in aovs:\n    if aov in existingAovs:\n        aovsToAdd.remove(aov)\n\nwith guerilla.Modifier() as mod:\n\n    for aov in layer.children():\n        if aov.PlugName.get() == \"Albedo\":\n            aov.OverrideSettings.set(True)\n            aov.DisplayDriver.set(\"exrid\")\n            aov.FileName.set(\"{openExrIdFile}\")\n\n    utils.SetRange(\"{frameRange}\")\n    utils.SetOptims()\n\n    if \"{jobType}\" == \"LD\":\n        utils.SetLowRenderParms()\n    else:\n        utils.SetFinalRenderParms()\n\n    prefNode = guerilla.Document().findchild(\"Preferences\")\n\n    prefNode.RenderfarmSequence.set(\"{jobName}\")\n    prefNode.DeferredRibGen.set(True)\n\n    renderPass = guerilla.Document().findchild(\"RenderPass\")\n    renderPass.FileName.set(\"{renderFile}\")\n    renderPass.DisplayDriver.set(\"exr\")\n\nsceneDir = guerilla.envcontext.getenv(\"SCENE_PATH\")\njobsDir = \"{{}}/jobs\".format(sceneDir)\n\noptions = guerilla.renderoptions({{}})\n\noptions[\"JobsDirectory\"] = jobsDir\noptions[\"DeferredRibGenBatch\"] = {inribgenbatchsize}\noptions[\"DeferredFile\"] = \"{{}}/{{}}_ribgen_{{}}.gproject\".format(jobsDir, options[\"FilePrefix\"], options[\"RenderId\"])\n\nscriptFiles = guerilla.render(\"none\", options)\n\ntmpDirPath = \"{boltTmpDir}\"\n\nribgenJobInfoFiles = []\nribgenJobPluginFiles = []\nrenderJobInfoFiles = []\nrenderJobPluginFiles = []\n\nfor scriptFile in scriptFiles:\n    args = scriptFile.getscriptargs(0)\n    file = scriptFile.getscriptfile(0)\n\n    randomStr = binascii.hexlify(os.urandom(6))\n\n    if \"ribgen\" in file:\n        ribgenJobInfoFile = \"{{}}/ribgen_job_info_{{}}.job\".format(tmpDirPath, randomStr)\n\n        with open(ribgenJobInfoFile, \"w\") as f:\n            f.write(\\\"\\\"\\\"{generatedRibgenJobInfos}\\\"\\\"\\\")\n\n        ribgenJobInfoFiles.append(ribgenJobInfoFile)\n\n        ribgenJobPluginFile = \"{{}}/ribgen_plugin_info_{{}}.job\".format(tmpDirPath, randomStr)\n\n        with open(ribgenJobPluginFile, \"w\") as f:\n            f.write(\\\"\\\"\\\"ScriptFile={{}}/{{}}\\nScriptArgs=\\\\\\\"{{}}\\\\\\\"\\\"\\\"\\\".format(jobsDir, file, args[0]))\n\n        ribgenJobPluginFiles.append(ribgenJobPluginFile)\n    else:\n        renderJobInfoFile = \"{{}}/render_job_info_{{}}.job\".format(tmpDirPath, randomStr)\n\n        with open(renderJobInfoFile, \"w\") as f:\n            f.write(\\\"\\\"\\\"{generatedRenderJobInfos}\\\"\\\"\\\")\n\n        renderJobInfoFiles.append(renderJobInfoFile)\n\n        renderJobPluginFile = \"{{}}/render_plugin_info_{{}}.job\".format(tmpDirPath, randomStr)\n\n        with open(renderJobPluginFile, \"w\") as f:\n            f.write(\\\"\\\"\\\"ScriptFile={{}}/{{}}\\nScriptArgs=\\\\\\\"{{}}\\\\\\\"\\\"\\\"\\\".format(jobsDir, file, args[0]))\n\n        renderJobPluginFiles.append(renderJobPluginFile)\n\nprint(\"RIBGEN_JOB_INFO_FILES={{}}\".format(ribgenJobInfoFiles))\nprint(\"RIBGEN_JOB_PLUGIN_FILES={{}}\".format(ribgenJobPluginFiles))\nprint(\"RENDER_JOB_INFO_FILES={{}}\".format(renderJobInfoFiles))\nprint(\"RENDER_JOB_PLUGIN_FILES={{}}\".format(renderJobPluginFiles))\n\nguerilla.Document().save()\n\"\"\"\n\n# Start the guerilla scene and execute the script to prepare it\n\ntmpScriptFilePath = BoltTempScript()\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\nBoltLogMessage(f\"GuerillaBatch : Start executing script : {tmpScriptFilePath}\")\n\nif platform.system == \"windows\":\n    command = [f\"{inenvironment['GUERILLA']}/guerillaBatch\", \"--nogui\"] \n    \n    if os.path.exists(inguerillafile):\n        command.append(inguerillafile)\n    \n    command.append(tmpScriptFilePath)\nelse:\n    command = [f\"{inenvironment['GUERILLA']}/guerilla\", \"--nogui\"]\n\n    if os.path.exists(inguerillafile):\n        command.append(inguerillafile)\n    \n    command.append(tmpScriptFilePath)\n\nBoltLogMessage(f\"GuerillaBatch Command : {' '.join(command)}\")\n\nenv = os.environ.copy()\nenv.update(inenvironment)\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env)\n\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    BoltLogError(stderrAsStr)\nelse:\n    BoltLogMessage(f\"GuerillaBatch : Finished executing script : {tmpScriptFilePath}\")\n    BoltLogMessage(stdoutAsStr)\n\n# Get the generated guerilla scriptfiles paths\n\nribgenJobInfoPattern = r\"RIBGEN_JOB_INFO_FILES=(\\S+)\"\nribgenJobPluginPattern = r\"RIBGEN_JOB_PLUGIN_FILES=(\\S+)\"\nrenderJobInfoPattern = r\"RENDER_JOB_INFO_FILES=(\\S+)\"\nrenderJobPluginPattern = r\"RENDER_JOB_PLUGIN_FILES=(\\S+)\"\n\nstdoutAsStr = re.sub(r\"(,)\\s(\\S)\", r\"\\g<1>\\g<2>\", stdoutAsStr)\n\nribgenJobInfoFileList = re.findall(ribgenJobInfoPattern, stdoutAsStr)[0]\nribgenJobPluginFileList = re.findall(ribgenJobPluginPattern, stdoutAsStr)[0]\nrenderJobInfoFileList = re.findall(renderJobInfoPattern, stdoutAsStr)[0]\nrenderJobPluginFileList = re.findall(renderJobPluginPattern, stdoutAsStr)[0]\n\noutribgenjobinfofiles = ast.literal_eval(ribgenJobInfoFileList.replace(\" \", \"\"))\noutribgenplugininfofiles = ast.literal_eval(ribgenJobPluginFileList.replace(\" \", \"\"))\noutrenderjobinfofiles = ast.literal_eval(renderJobInfoFileList.replace(\" \", \"\"))\noutrenderplugininfofiles = ast.literal_eval(renderJobPluginFileList.replace(\" \", \"\"))\noutrenderdir = renderDir\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
        "inguerillafile": [
          {
            "shortName": "inguerillafile",
            "longName": "Scene File",
            "index": 0,
