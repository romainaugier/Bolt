    {
      "name": "Deadline_SubmitGuerillaJob",
      "category": "Deadline",
      "id": "3565303433643633653366306437326164393339663232356261336131626535",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/deadline.png",
      "definitionPath": "$BOLT_LIB/Nodes/deadline_submit_guerilla_job.bnode",
      "nodeType": "Deadline/Deadline_SubmitGuerillaJob",
      "opCode": "\nimport subprocess, re\n\nBoltLogMessage(f\"Deadline : Submitting ribgen jobs\")\n\nribgenJobIds = \"\"\n\nfor i in range(len(inribgenjobinfofiles)):\n    ribGenJobInfoFile = inribgenjobinfofiles[i]\n    ribGenJobPluginFile = inribgenjobpluginfiles[i]\n\n    command = [\n        \"deadlinecommand\",\n        ribGenJobInfoFile, \n        ribGenJobPluginFile\n    ]\n\n    process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\n    stdout, stderr = process.communicate()\n\n    stdoutAsStr = stdout.decode(\"utf-8\")\n    stderrAsStr = stderr.decode(\"utf-8\")\n\n    if len(stderrAsStr) > 0:\n        BoltLogError(stderrAsStr)\n    else:\n        jobIdPattern = r\"JobID=(\\S+)\"\n\n        matches = re.findall(jobIdPattern, stdoutAsStr)\n\n        id = matches[0]\n\n        if len(ribgenJobIds) == 0:\n            ribgenJobIds += f\"{id}\"\n        else:\n            ribgenJobIds += f\",{id}\"\n\n        BoltLogMessage(stdoutAsStr)\n\nBoltLogMessage(\"Deadline : Finished submitting ribgen jobs\")\n\nrenderJobIds = []\n\nfor i in range(len(inrenderjobinfofiles)):\n    renderJobInfoFile = inrenderjobinfofiles[i]\n    renderJobPluginFile = inrenderjobpluginfiles[i]\n\n    with open(renderJobInfoFile, \"r\") as file:\n        jobInfos = file.read()\n\n    jobInfos = jobInfos.replace(\"JobDependencies=\", f\"JobDependencies={ribgenJobIds}\")\n\n    with open(renderJobInfoFile, \"w\") as file:\n        file.write(jobInfos)\n\n    command = [\n        \"deadlinecommand\",\n        renderJobInfoFile, \n        renderJobPluginFile\n    ]\n\n    process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\n    stdout, stderr = process.communicate()\n\n    stdoutAsStr = stdout.decode(\"utf-8\")\n    stderrAsStr = stderr.decode(\"utf-8\")\n\n    if len(stderrAsStr) > 0:\n        BoltLogError(stderrAsStr)\n    else:\n        jobIdPattern = r\"JobID=(\\S+)\"\n\n        matches = re.findall(jobIdPattern, stdoutAsStr)\n\n        id = matches[0]\n\n        renderJobIds.append(id)\n\n        BoltLogMessage(stdoutAsStr)\n\noutrenderjobid = renderJobIds[0]\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
