    "opCode": "# BeginOp\n\nimport sys\n\nprint(\"Flash Node compiled and ran with : \", sys.version)\n\n# A set of utility functions are available for the user\n# Returns the temporary directory so the user can store files there\n# (such as generated script files...)\nflashTempDir = FlashTempDir()\n\n# Prints a message to the Flash Console\nFlashLogMessage(\"Cooking template node...\")\n\n# plugs can be called with their shortName\nprint(\"Integer Input Plug : \", inint)\nprint(\"Float Input Plug : \", infloat)\nprint(\"String Input Plug : \", instring)\nprint(\"Boolean Input Plug : \", inbool)\nprint(\"Custom Input Plug : \", incustom)\nprint(\"Dict Input Plug : \", indict)\n\noutlist = [inint, infloat, instring, inbool]\n\nprint(\"List Output Plug : \", outlist)\n\n",
