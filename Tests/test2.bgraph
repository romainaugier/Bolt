    {
      "name": "Oeuf_FetchAnimation1",
      "category": "Oeuf",
      "id": "6463653565393961623264643730346465353732613338336166663931393436",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/animation.png",
      "definitionPath": "$BOLT_LIB/Nodes/oeuf_fetch_animation.bnode",
      "nodeType": "Oeuf/Oeuf_FetchAnimation",
      "opCode": "\nimport os, re\n\nsequence = inshotspecs[\"Sequence\"]\nshot = inshotspecs[\"Shot\"]\nanimDir = f\"{inanimationdir}/{sequence}/{shot}\"\n\ncharlesMatches = [\"CHARLES\", \"Charles\", \"charles\"]\ncorinneMatches = [\"CORINNE\", \"Corinne\", \"corinne\"]\noeufsMatches = [\"OEUFS\", \"OEUF\", \"Oeufs\", \"Oeuf\", \"oeufs\", \"oeuf\"]\n\nfetchCharles = False\nfetchCorinne = False\nfetchOeufs = False\n\nfor item in inanimtofetch:\n    if item in charlesMatches:\n        fetchCharles = True\n    elif item in corinneMatches:\n        fetchCorinne = True\n    elif item in oeufsMatches:\n        fetchOeufs = True\n\noutanimpaths = []\n\nfor dir in os.listdir(animDir):\n    if fetchCharles:\n        if dir in charlesMatches:\n            charlesDirPath = f\"{animDir}/{dir}\"\n            lastVersionDir = ClientUtils.GetLastVersionDir(charlesDirPath)\n\n            fileCount = len(os.listdir(lastVersionDir))\n\n            if fileCount == 0:\n                BoltLogError(f\"No animation export of Charles is available in directory '{lastVersionDir}'\")\n            elif fileCount > 1:\n                BoltLogWarning(f\"More than one file exists in directory '{lastVersionDir}'. Using the first available\")\n                charlesAnimPath = f\"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}\"\n                outanimpaths.append(charlesAnimPath)\n            else:\n                charlesAnimPath = f\"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}\"\n                outanimpaths.append(charlesAnimPath)\n            \n            continue\n    if fetchCorinne:\n        if dir in corinneMatches:\n            corinneDirPath = f\"{animDir}/{dir}\"\n            lastVersionDir = ClientUtils.GetLastVersionDir(corinneDirPath)\n\n            fileCount = len(os.listdir(lastVersionDir))\n\n            if fileCount == 0:\n                BoltLogError(f\"No animation export of Corinne is available in directory '{lastVersionDir}'\")\n            elif fileCount > 1:\n                BoltLogWarning(f\"More than one file exists in directory '{lastVersionDir}'. Using the first available\")\n                corinneAnimPath = f\"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}\"\n                outanimpaths.append(corinneAnimPath)\n            else:\n                corinneAnimPath = f\"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}\"\n                outanimpaths.append(corinneAnimPath)\n            \n            continue\n    if fetchOeufs:\n        oeufPattern = re.compile(r\".*OEUF.*|.*Oeuf.*|.*oeuf.*|.*OEUFS.*|.*Oeufs.*|.*oeufs.*\")\n\n        if re.search(oeufPattern, dir):\n            oeufDirPath = f\"{animDir}/{dir}\"\n            lastVersionDir = ClientUtils.GetLastVersionDir(oeufDirPath)\n\n            fileCount = len(os.listdir(lastVersionDir))\n\n            if fileCount == 0:\n                BoltLogError(f\"No animation export of oeuf is available in directory '{lastVersionDir}'\")\n            elif fileCount > 1:\n                BoltLogWarning(f\"More than one file exists in directory '{lastVersionDir}'. Using the first available\")\n                oeufAnimPath = f\"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}\"\n                outanimpaths.append(oeufAnimPath)\n            else:\n                oeufAnimPath = f\"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}\"\n                outanimpaths.append(oeufAnimPath)\n            \n            continue\n\n    print(dir)\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
        "inshotspecs": [
          {
            "shortName": "inshotspecs",
            "longName": "Shot Specs",
            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": {
              "FrameRange": "100-240",
              "Sequence": "SQ020",
              "Shot": "SHOT060"
            },
            "defaultData": {},
            "type": 10,
            "connectionName": "outshotspecs",
            "connectionNodeId": "3931616262336232373538326531616233323966386632616639656663613533"
          }
        ],
        "inanimationdir": [
          {
            "shortName": "inanimationdir",
            "longName": "Animation Directory Path",
            "index": 0,
            "isExposed": true,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": "$ANIM_DIR",
            "defaultData": "$ANIM_DIR",
            "type": 7,
            "connectionName": null,
            "connectionNodeId": null
          }
        ],
        "inanimtofetch": [
          {
