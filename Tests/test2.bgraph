      "iconPath": "$BOLT_ICONS/camera.png",
      "definitionPath": "$BOLT_LIB/Nodes/oeuf_fetch_camera.bnode",
      "nodeType": "Oeuf/Oeuf_FetchCamera",
      "opCode": "\nimport os\n\nsequence = inshotspecs[\"Sequence\"]\nshot = inshotspecs[\"Shot\"]\ncamDir = f\"{inanimationdir}/{sequence}/{shot}/cam\"\n\ncamLastVersionDir = ClientUtils.GetLastVersionDir(camDir)\nfileCount = len(os.listdir(camLastVersionDir))\n\nif fileCount == 0:\n    BoltLogError(f\"No file is available in directory '{camLastVersionDir}'\")\nelif fileCount > 1:\n    BoltLogWarning(f\"More than one file has been found in directory '{camLastVersionDir}'\")\n    outcampath = f\"{camLastVersionDir}/{os.listdir(camLastVersionDir)[0]}\"\nelse:\n    outcampath = f\"{camLastVersionDir}/{os.listdir(camLastVersionDir)[0]}\"\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
        "inshotspecs": [
          {
            "shortName": "inshotspecs",
            "longName": "Shot Specs",
