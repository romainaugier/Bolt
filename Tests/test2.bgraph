      "nodeType": "Houdini/Hou_Hython",
      "opCode": "\nimport subprocess, os, sys\n\nBoltLogMessage(f\"Hython : Start executing script : {inscript}\")\n\ncommand = [\"hython\"]\n\nif os.path.exists(inhoufile):\n    command.append(inhoufile)\n\ncommand.append(inscript)\n\nBoltLogMessage(f\"Hython Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, encoding=\"ISO-8859-1\")\n\nwhile True:\n    output = process.stdout.readline()\n    errput = process.stderr.readline()\n\n    if process.poll() is not None:\n        break\n    if len(errput) > 0:\n        BoltLogError(errput)\n        BoltLogError(f\"Hython error, terminating subprocess. Check the log for more details\")\n        sys.stderr.flush()\n        process.terminate()\n        break\n    if output:\n        print(output.strip())\n\n\nBoltLogMessage(f\"Hython : Finished executing script : {inscript}\")\n\n",
