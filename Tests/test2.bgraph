            "longName": "Animation To Fetch",
            "index": 0,
            "isExposed": true,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": [
              "CHARLES",
              "CORINNE",
              "OEUFS"
            ],
            "defaultData": [
