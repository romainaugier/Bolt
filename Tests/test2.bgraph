{
  "nodes": [
    {
      "name": "Guerilla_CopytoLocal",
      "category": "Guerilla",
      "id": "6136303863643237336132636231633939336233366532393430373864643732",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/guerilla-render.png",
      "definitionPath": "$BOLT_LIB/Nodes/guerilla_copy_local.bnode",
      "nodeType": "Guerilla/Guerilla_CopytoLocal",
      "opCode": "\nimport os, re, shutil, subprocess\n\ndef makeLocal(filePath, localDir, dir=True):\n    import os\n\n    if dir:\n        fileDir = os.path.dirname(filePath)\n        dirStruct = \"/\".join(fileDir.split(\"/\")[1:])\n        return f\"{localDir}/{dirStruct}\"\n    else:\n        dirStruct = \"/\".join(filePath.split(\"/\")[1:])\n        return f\"{localDir}/{dirStruct}\"\n\ndef findTexFile(filePath): \n    import os\n\n    texName, _ = os.path.splitext(os.path.basename(filePath))\n\n    guerillaDir = f\"{os.path.dirname(filePath)}/.guerilla\"\n\n    if os.path.exists(guerillaDir):\n        for file in os.listdir(guerillaDir):\n            if texName in file:\n                return f\"{guerillaDir}/{file}\"\n\n    return None\n\nlocalDir = makeLocal(inguerillafile, inlocaldir)\nremoteDir = inguerillafile.split(\"/\")[0] + \"/\"\nlocalGuerillaFile = makeLocal(inguerillafile, inlocaldir, dir=False)\nlocalGuerillaFileName = localGuerillaFile.replace(\".gproject\", \"_local.gproject\")\n\nBoltLogMessage(f\"Copied file to local : {localGuerillaFile}\")\n\nif not os.path.exists(os.path.dirname(localGuerillaFile)):\n    os.makedirs(os.path.dirname(localGuerillaFile))\n\nshutil.copy2(inguerillafile, localGuerillaFile)\n\nremoteAbcFilePattern = re.compile(\"{}[\\da-zA-Z\\/_\\.-]*\\.abc\".format(remoteDir.replace('/', '\\/')))\nremoteTexFilePattern = re.compile(\"{}[\\da-zA-Z\\/_\\.-]*\\.[png|jpg|exr|tif|tiff|jpeg]+\".format(remoteDir.replace('/', '\\/')))\n\nwith open(localGuerillaFileName, \"w\") as localFile:\n    with open(localGuerillaFile, \"r\") as file:\n        for line in file:\n            geoMatches = re.findall(remoteAbcFilePattern, line)\n            texMatches = re.findall(remoteTexFilePattern, line)\n\n            if geoMatches:\n                for match in geoMatches:\n                    dependencyPath = match\n                    localDependencyPath = makeLocal(match, inlocaldir, dir=False)\n                    \n                    BoltLogMessage(f\"Found geometry dependency : {dependencyPath}\")\n                    \n                    try:    \n                        ClientUtils.SafeCopy(dependencyPath, localDependencyPath)\n\n                        line = line.replace(dependencyPath, localDependencyPath)\n\n                    except:\n                        BoltLogWarning(f\"Dependency : {dependencyPath} can't be found, discarding it\")\n\n            elif texMatches:\n                for match in texMatches:\n                    dependencyPath = match\n                    localDependencyPath = makeLocal(dependencyPath, inlocaldir, dir=False)\n            \n                    BoltLogMessage(f\"Found texture dependency : {dependencyPath}\")\n\n                    txDependencyPath = findTexFile(dependencyPath)\n                    localTxDependencyPath = None\n\n                    if txDependencyPath is not None:\n                        BoltLogMessage(f\"Found corresponding tx file : {txDependencyPath}\")\n                        localTxDependencyPath = makeLocal(txDependencyPath, inlocaldir, dir=False)\n\n                    try: \n                        ClientUtils.SafeCopy(dependencyPath, localDependencyPath)\n\n                        line = line.replace(dependencyPath, localDependencyPath)\n\n                        if localTxDependencyPath is not None:\n                            ClientUtils.SafeCopy(txDependencyPath, localTxDependencyPath)\n                    except:\n                        BoltLogWarning(f\"Dependency : {dependencyPath} can't be found, discarding it\")\n                \n            localFile.write(line)\n\n",
      "disabled": false,
      "isSubGraph": false,
