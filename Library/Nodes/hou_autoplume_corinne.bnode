import os

fr = inshotspecs["FrameRange"].split("-")
framerange = [int(fr[0]), int(fr[1])]

cacheDir = f"{incachedir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/Corinne"
outputfilefur = f"{cacheDir}/{inshotspecs['Sequence']}_{inshotspecs['Shot']}_corinne_cache_fur.abc"
outputfileplumes = f"{cacheDir}/{inshotspecs['Sequence']}_{inshotspecs['Shot']}_corinne_cache_plumes.abc"

generatedScript = f"""import hou
animSopNode = None
plumeSopNode = None

for node in hou.node("/obj").children():
    if node.name() == "anim_import":
        animSopNode = node
    elif node.name() == "EXPORT":
        plumeSopNode = node

if animSopNode != None:
    for node in animSopNode.children():
        if node.type().name() == "alembic":
            node.parm("fileName").set("{inanimationfile}")
            break

if plumeSopNode != None:
    for node in plumeSopNode.children():
        if node.name() == "rop_alembic_fur":
            node.parm("filename").set("{outputfilefur}")
            node.parm("f1").set({framerange[0]})
            node.parm("f2").set({framerange[1]})
            node.parm("execute").pressButton()
        if node.name() == "rop_alembic_plumes":
            node.parm("filename").set("{outputfileplumes}")
            node.parm("f1").set({framerange[0]})
            node.parm("f2").set({framerange[1]})
            node.parm("execute").pressButton()
"""

tmpScriptFilePath = BoltTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath
outabccachefile = [outputfilefur, outputfileplumes]

# EndOp
