// Submits a guerilla job to deadline using : 
// deadlinecommand -Multi -job ribgen_job_info.job ribgen_plugin_info.job -job -dependsOnPrevious render_job_info.job render_plugin_info.job
// and outputs the job id if the job has been submitted successfully

# BeginAttr

name = Deadline_SubmitGuerillaJob
icon = $BOLT_ICONS/deadline.png
category = Deadline

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inribgenjobinfofiles
longName = Ribgen Job Info Files
defaultValue = []
type = list
exposed = False

# EndPlug

# BeginPlug

shortName = inribgenjobpluginfiles
longName = Ribgen Job Plugin Files
defaultValue = []
type = list
exposed = False

# EndPlug

# BeginPlug

shortName = inrenderjobinfofiles
longName = Render Job Info Files
defaultValue = []
type = list
exposed = False

# EndPlug

# BeginPlug

shortName = inrenderjobpluginfiles
longName = Render Job Plugin Files
defaultValue = []
type = list
exposed = False

# EndPlug

# BeginPlug

shortName = outribgenjobid
longName = Ribgen Job ID
defaultValue = ""
type = str

# EndPlug

# BeginPlug

shortName = outrenderjobid
longName = Render Job ID
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

import subprocess, re

BoltLogMessage(f"Deadline : Submitting ribgen jobs")

ribgenJobIds = ""

for i in range(len(inribgenjobinfofiles)):
    ribGenJobInfoFile = inribgenjobinfofiles[i]
    ribGenJobPluginFile = inribgenjobpluginfiles[i]

    command = [
        "deadlinecommand",
        ribGenJobInfoFile, 
        ribGenJobPluginFile
    ]

    process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
    stdout, stderr = process.communicate()

    stdoutAsStr = stdout.decode("utf-8")
    stderrAsStr = stderr.decode("utf-8")

    if len(stderrAsStr) > 0:
        BoltLogError(stderrAsStr)
    else:
        jobIdPattern = r"JobID=(\S+)"

        matches = re.findall(jobIdPattern, stdoutAsStr)

        id = matches[0]

        if len(ribgenJobIds) == 0:
            ribgenJobIds += f"{id}"
        else:
            ribgenJobIds += f",{id}"

        BoltLogMessage(stdoutAsStr)

BoltLogMessage("Deadline : Finished submitting ribgen jobs")

renderJobIds = []

for i in range(len(inrenderjobinfofiles)):
    renderJobInfoFile = inrenderjobinfofiles[i]
    renderJobPluginFile = inrenderjobpluginfiles[i]

    with open(renderJobInfoFile, "r") as file:
        jobInfos = file.read()

    jobInfos = jobInfos.replace("JobDependencies=", f"JobDependencies={ribgenJobIds}")

    with open(renderJobInfoFile, "w") as file:
        file.write(jobInfos)

    command = [
        "deadlinecommand",
        renderJobInfoFile, 
        renderJobPluginFile
    ]

    process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
    stdout, stderr = process.communicate()

    stdoutAsStr = stdout.decode("utf-8")
    stderrAsStr = stderr.decode("utf-8")

    if len(stderrAsStr) > 0:
        BoltLogError(stderrAsStr)
    else:
        jobIdPattern = r"JobID=(\S+)"

        matches = re.findall(jobIdPattern, stdoutAsStr)

        id = matches[0]

        renderJobIds.append(id)

        BoltLogMessage(stdoutAsStr)

outrenderjobid = renderJobIds[0]

# EndOp