// Calls robocopy.exe with a few arguments 

# BeginAttr

name = Robocopy
category = IO
icon = $BOLT_ICONS/fastcopy.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = insrcdir
longName = Source Directory
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = indstdir
longName = Destination Directory
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = infilepattern
longName = File Pattern
defaultValue = ""
type = str
exposed = True

# EndPlug

# BeginPlug

shortName = incopysubdirs
longName = Copy Subdirectories
defaultValue = True
type = bool
exposed = True

# EndPlug

# BeginPlug

shortName = inlog
longName = Enable Logging
defaultValue = False
type = bool
exposed = True

# EndPlug

# BeginPlug

shortName = outdir
longName = Output Directory
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

import subprocess, os, sys

BoltLogMessage(f"Robocopy : Start copying {insrcdir} -> {indstdir}")

command = ["robocopy", insrcdir, indstdir]

if len(infilepattern) > 0:
    command.append(infilepattern)

command.extend(["/J", "/Z", "/MT:{}".format(int(os.getenv("NUMBER_OF_PROCESSORS")))])

if incopysubdirs:
    command.append("/s")

if not inlog:
    command.extend(["/ns", "/nc", "/nfl", "/ndl", "/np", "/njh", "/njs"])

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    BoltLogError(stderrAsStr)
else:
    BoltLogMessage(f"Robocopy : Finished copying")
    BoltLogMessage(stdoutAsStr)

outdir = indstdir

# EndOp
