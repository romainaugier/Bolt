// Generates render options for a hd render

# BeginAttr

name = Oeuf_RenderOptionsHD
icon = $FLASH_ICONS/volcan.png
category = Oeuf

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inrenderoptions
longName = Render Options
defaultValue = {"Type":"HD","Team":"oeuf","SequenceName":"sequence","ShotName":"shot","Optims":True,"FrameRange":"100-240"}
type = dict
exposed = True

# EndPlug

# BeginPlug

shortName = outrenderoptions
longName = Output Render Options
defaultValue = {}
type = dict

# EndPlug

# EndPlugs

# BeginOp

outrenderoptions = inrenderoptions

# EndOp