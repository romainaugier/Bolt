import os

if isinstance(inanimationfile, list):
    inanimationfile = inanimationfile[0]

fr = inshotspecs["FrameRange"].split("-")
framerange = [int(fr[0]), int(fr[1])]

animationdir = os.path.dirname(inanimationfile).replace("\\", "/") 
animationfilename, animationfileext = os.path.splitext(os.path.basename(inanimationfile))
inanimationlocalfile = f"{ClientUtils.GetRoamingDataDir()}/{animationfilename}{animationfileext}"
outlocalanimationfile = f"{ClientUtils.GetRoamingDataDir()}/{animationfilename}_displaced{animationfileext}"
outanimationfile = f"{animationdir}/{animationfilename}_displaced{animationfileext}"

BoltLogMessage("Copying animation file to local")

ClientUtils.SafeCopy(inanimationfile, inanimationlocalfile)

BoltLogMessage(f"Animation file copied to local : {inanimationlocalfile}")

inwaterplanelocalfile = f"{ClientUtils.GetRoamingDataDir()}/{os.path.basename(inwaterplanefile)}"

BoltLogMessage("Copying water file to local")

ClientUtils.SafeCopy(inwaterplanefile, inwaterplanelocalfile)

BoltLogMessage(f"Water plane file copied to local : {inwaterplanelocalfile}")

BoltLogMessage(f"Output animation file : {outanimationfile}")

generatedScript = f"""import hou, os, subprocess

def copy(src, dst):
    srcDir = os.path.dirname(src)
    dstDir = os.path.dirname(dst)
    
    srcName = os.path.basename(src)
    
    command = []
    command.append("robocopy")
    command.append(srcDir)
    command.append(dstDir)
    command.append(srcName)
    command.append("/MT:32")
    command.append("/s")
    command.append("/J")
    command.append("/z")
    
    p = subprocess.Popen(command)
    
    p.wait()

animSopNode = None
waterSopNode = None
exportSopNode = None

for node in hou.node("/obj").children():
    if node.name() == "in_crowd":
        animSopNode = node
    elif node.name() == "in_ocean":
        waterSopNode = node
    elif node.name() == "process":
        exportSopNode = node

if animSopNode != None:
    for node in animSopNode.children():
        if node.type().name() == "alembic":
            node.parm("fileName").set("{inanimationlocalfile}")
            break

if waterSopNode != None:
    for node in waterSopNode.children():
        if node.type().name() == "alembic":
            node.parm("fileName").set("{inwaterplanelocalfile}")
            break

if exportSopNode != None:
    for node in exportSopNode.children():
        if node.type().name() == "rop_alembic":
            node.parm("filename").set("{outlocalanimationfile}")
            node.parm("f1").set({framerange[0]})
            node.parm("f2").set({framerange[1]})
            node.parm("execute").pressButton()

            print("Copying file to output location")
            copy("{outlocalanimationfile}", "{outanimationfile}")
"""

tmpScriptFilePath = BoltTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath
outabcanimationfile = outanimationfile

# EndOp
