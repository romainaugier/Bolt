// Just passes data from its input to the output, mostly used to layout connections

# BeginAttr

name = Null
category = Utility

# EndAttr

# BeginPlugs

# BeginPlug

shortName = input
longName = Input Data
default = ""
type = custom
exposed = False

# EndPlug

# BeginPlug

shortName = output
longName = Output Data
default = ""
type = custom

# EndPlug

# EndPlugs

# BeginOp

ouput = input

# EndOp