# BeginOp

generatedScript = f"""import guerilla, os

import RomanoTools.Guerilla.Utils as utils

if os.path.exists("{infilepath}"):
    os.remove("{infilepath}")

dir = os.path.dirname("{infilepath}")

if not os.path.exists(dir):
    os.makedirs(dir)

utils.SetOptims()
utils.SetRange("{inframerange[0]}-{inframerange[1]}")

renderPass = guerilla.Document().findchild("RenderPass")

renderPass.FileLayerName.set("$o_$n")
renderPass.DisplayDriver.set("exr")

guerilla.Document().ProjectWidth.set(2048)
guerilla.Document().ProjectHeight.set(858)

layer = guerilla.Document().findchild("RenderPass|Layer")

aovNames = {inrenderpasses}

aovsToAdd = {inrenderpasses}

existingAovs = [aov.PlugName.get() for aov in layer.children()]

for aov in aovNames:
	if aov in existingAovs:
		aovsToAdd.remove(aov)

with guerilla.Modifier() as mod:
	for aov in aovsToAdd:
		layer.addaov(aov)

guerilla.Document().save("{infilepath}")
"""

tmpScriptFilePath = BoltTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath
outscripttext = generatedScript

# EndOp