// Copy a file and its dependencies to local, and remap them

# BeginAttr 

name = Guerilla_CopytoLocal
category = Guerilla
color = [0, 0, 0]
icon = $BOLT_ICONS/guerilla-render.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inguerillafile
longName = Guerilla File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug 

shortName = inlocaldir
longName = Local Directory
defaultValue = "D:/E5"
type = str
exposed = True

# EndPlug

# EndPlugs

# BeginOp

import os, re, shutil, subprocess

def makeLocal(filePath, localDir, dir=True):
    import os

    if dir:
        fileDir = os.path.dirname(filePath)
        dirStruct = "/".join(fileDir.split("/")[1:])
        return f"{localDir}/{dirStruct}"
    else:
        dirStruct = "/".join(filePath.split("/")[1:])
        return f"{localDir}/{dirStruct}"

def findTexFile(filePath): 
    import os

    texName, _ = os.path.splitext(os.path.basename(filePath))

    guerillaDir = f"{os.path.dirname(filePath)}/.guerilla"

    if os.path.exists(guerillaDir):
        for file in os.listdir(guerillaDir):
            if texName in file:
                return f"{guerillaDir}/{file}"

    return None

localDir = makeLocal(inguerillafile, inlocaldir)
remoteDir = inguerillafile.split("/")[0] + "/"
localGuerillaFile = makeLocal(inguerillafile, inlocaldir, dir=False)
localGuerillaFileName = localGuerillaFile.replace(".gproject", "_local.gproject")

BoltLogMessage(f"Copied file to local : {localGuerillaFile}")

if not os.path.exists(os.path.dirname(localGuerillaFile)):
    os.makedirs(os.path.dirname(localGuerillaFile))

shutil.copy2(inguerillafile, localGuerillaFile)

remoteAbcFilePattern = re.compile("{}[\da-zA-Z\/_\.-]*\.abc".format(remoteDir.replace('/', '\/')))
remoteTexFilePattern = re.compile("{}[\da-zA-Z\/_\.-]*\.[png|jpg|exr|tif|tiff|jpeg]+".format(remoteDir.replace('/', '\/')))

with open(localGuerillaFileName, "w") as localFile:
    with open(localGuerillaFile, "r") as file:
        for line in file:
            geoMatches = re.findall(remoteAbcFilePattern, line)
            texMatches = re.findall(remoteTexFilePattern, line)

            if geoMatches:
                for match in geoMatches:
                    dependencyPath = match
                    localDependencyPath = makeLocal(match, inlocaldir, dir=False)
                    
                    BoltLogMessage(f"Found geometry dependency : {dependencyPath}")
                    
                    try:    
                        ClientUtils.SafeCopy(dependencyPath, localDependencyPath)

                        line = line.replace(dependencyPath, localDependencyPath)

                    except:
                        BoltLogWarning(f"Dependency : {dependencyPath} can't be found, discarding it")

            elif texMatches:
                for match in texMatches:
                    dependencyPath = match
                    localDependencyPath = makeLocal(dependencyPath, inlocaldir, dir=False)
            
                    BoltLogMessage(f"Found texture dependency : {dependencyPath}")

                    txDependencyPath = findTexFile(dependencyPath)
                    localTxDependencyPath = None

                    if txDependencyPath is not None:
                        BoltLogMessage(f"Found corresponding tx file : {txDependencyPath}")
                        localTxDependencyPath = makeLocal(txDependencyPath, inlocaldir, dir=False)

                    try: 
                        ClientUtils.SafeCopy(dependencyPath, localDependencyPath)

                        line = line.replace(dependencyPath, localDependencyPath)

                        if localTxDependencyPath is not None:
                            ClientUtils.SafeCopy(txDependencyPath, localTxDependencyPath)
                    except:
                        BoltLogWarning(f"Dependency : {dependencyPath} can't be found, discarding it")
                
            localFile.write(line)

# EndOp