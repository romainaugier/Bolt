// Here there is everything that can be used to build a Flash node
// This is a comment

# BeginAttr             // Begin the attributes definition

name = Template         // Name of the node
inputs = 1              // Number of inputs
outputs = 1             // Number of outputs
color = [255, 127, 64]  // Color that will be used in the interface

# EndAttr               // End the attributes definition

# BeginParms            // Begin the parameters definition

# BeginParm             // Begin one parameter definition

shortName = intparm
longName = Integer Parameter
defaultValue = 0

# EndParm               // End one parameter definition

# BeginParm             // Begin one parameter definition

shortName = floatparm
longName = Float Parameter
defaultValue = 10.0

# EndParm               // End one parameter definition

# BeginParm             // Begin one parameter definition

shortName = stringparm
longName = String Parameter
defaultValue = "bonjour"

# EndParm               // End one parameter definition

# BeginParm             // Begin one parameter definition

shortName = boolparm
longName = Boolean Parameter
defaultValue = True

# EndParm               // End one parameter definition

# EndParms              // End the parameters definition

# BeginOp               // Begin the operation code 

import sys

print("Flash Node compiled and ran with : ", sys.version)

# A set of utility functions are available for the user
# Returns the temporary directory so the user can store files there
# (such as generated script files...)
flashTempDir = FlashTempDir()

# parameters can be called with their shortName
print("Integer Parameter : ", intparm)
print("Float Parameter : ", floatparm)
print("String Parameter : ", stringparm)
print("Boolean Parameter : ", boolparm)

# outputs can be called with output + output number (starting at 0)
output0 = f"Integer Parm : {intparm}, Float Parm : {floatparm}, String Parm : {stringparm}, Bool Parm : {boolparm}"

# EndOp                 // End the operation code