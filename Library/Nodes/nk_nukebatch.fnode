// Executes a nuke script 

# BeginAttr

name = NK_NukeBatch
icon = $FLASH_ICONS/nuke.png
category = Nuke

# EndAttr

# BeginPlugs

# BeginPlug

shortName = innukefile
longName = Nuke File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inframerange
longName = Frame Range
defaultValue = [100, 240]
type = int2
exposed = True

# EndPlug

# BeginPlug

shortName = innukebindir
longName = Nuke Binary Directory
defaultValue = "C:/Program Files/Nuke"
type = str
exposed = True

# EndPlug

# BeginPlug

shortName = outfile
longName = Output File
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

import subprocess, os

FlashLogMessage(f"NukeBatch : Start executing script : {inscript}")

command = [f"{innukebindir}/nuke", "-F", f"{inframerange[0]}-{inframerange[1]}", "-x", innukefile]

FlashLogMessage(f"NukeBatch Command : {' '.join(command)}")

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"NukeBatch : Finished executing file : {innukefile}")
    FlashLogMessage(stdoutAsStr)

outfile = innukefile

# EndOp