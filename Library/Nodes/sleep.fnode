// Sleeps for a given time. Used to debug

# BeginAttr

name = Sleep
color = [50, 222, 132]
icon = $FLASH_ICONS/debug.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = indata
longName = Input Data
default = None
type = custom
exposed = False

# EndPlug

# BeginPlug

shortName = intime
longName = Sleeping Time
default = 2
type = int
exposed = True

# EndPlug

# BeginPlug

shortName = outdata
longName = Output Data
default = None
type = custom
exposed = False

# EndPlug

# EndPlugs

# BeginOp

import time

FlashLogMessage(f"Sleeping for {intime} seconds")

time.sleep(intime)

outdata = indata

# EndOp