// Generates a script to load rendergraphs into a gproject file

# BeginAttr

name = Guerilla_LoadRenderGraphs
icon = $FLASH_ICONS/guerilla-render.png
category = Guerilla

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inrgfiles
longName = RenderGraph Files
defaultValue = [""]
type = list
exposed = False

# EndPlug

# BeginPlug

shortName = outscriptfile
longName = Output Script File
defaultValue = ""
type = str

# EndPlug

# BeginPlug

shortName = outscripttext
longName = Output Script Text
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

if type(inrgfiles) is str:
    inabcfiles = [inrgfiles]

generatedScript = f"""import guerilla, os

paths = {inrgfiles}

for path in paths:
    name = os.path.basename(path)

    loaded = guerilla.Document().loadfile(path)

    if not loaded:
        FlashLogWarning("Could not load {{}} in guerilla file".format(name))

guerilla.Document().save()
"""

tmpScriptFilePath = FlashTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath
outscripttext = generatedScript

# EndOp