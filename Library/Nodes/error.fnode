// Debug node that emits an error. Used for app testing

# BeginAttr

name = Error
color = [50, 222, 132]
icon = D:/dev/Flash/Library/Icons/debug.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = indata
longName = Input Data
defaultValue = None
type = custom
exposed = False

# EndPlug

# BeginPlug

shortName = outdata
longName = Output Data
defaultValue = None
type = custom
exposed = False

# EndPlug

# EndPlugs

# BeginOp

FlashLogError("You have done something bad")

FlashError()

outdata = indata

# EndOp