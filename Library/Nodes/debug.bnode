// Prints the input data and returns it

# BeginAttr

name = Debug
color = [50, 222, 132]
icon = $BOLT_ICONS/debug.png
category = Debug

# EndAttr

# BeginPlugs

# BeginPlug

shortName = indata
longName = Input Data
default = None
type = custom
exposed = False

# EndPlug

# BeginPlug

shortName = outdata
longName = Output Data
default = None
type = custom
exposed = False

# EndPlug

# EndPlugs

# BeginOp

BoltLogMessage(f"Debug Node : {indata}")

outdata = indata

# EndOp