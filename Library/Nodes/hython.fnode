// Calls hython.exe with a generated script file passed in the first input

# BeginAttr

name = Hython
inputs = 1
outputs = 0
color = [255, 87, 34]

# EndAttr

# BeginOp

import subprocess

print(f"Hython : Start executing script : {input0}")

process = subprocess.Popen(["hython", input0], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

print(f"Hython : Finished executing script : {input0}")
print(f"Stdout : {stdout}")
print(f"Stderr : {stderr}")

# EndOp