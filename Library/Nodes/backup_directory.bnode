// Node Definition automatically generated by Bolt

# BeginAttr

name = Backup_Directory
category = Utility
color = [0, 0, 0]
icon = $BOLT_ICONS/util.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = indirtobackup
longName = Directory To Save
defaultValue = "D:/backup"
type = str
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inbackupdir
longName = Backup Directory
defaultValue = "Z:/OEUF"
type = str
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inenablefilters
longName = Enable File Filtering
defaultValue = True
type = bool
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = infilefilters
longName = File Filters
defaultValue = ["abc", "fbx", "hipnc", "hip", "ma", "mb", "spp", "zpr", "gproject", "grendergraph", "json", "exr", "png", "jpg", "tex"]
type = list
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = outbackupdir
longName = Output Backup Directory
defaultValue = ""
type = str
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# EndPlugs

# BeginOp

import os, subprocess, multiprocessing

command = ["robocopy", indirtobackup, inbackupdir]

if inenablefilters:
    for filter in infilefilters:
        fileFilter = f"*.{filter}"
        command.append(fileFilter)

options = ["/s", "/j", f"/MT:{multiprocessing.cpu_count()}", "/NS", "/NC", "/IT", "/MAX:5000000000"]

for option in options:
    command.append(option)

BoltLogMessage("Starting backup")
BoltLogMessage(f"Command : {' '.join(command)}")

process = subprocess.Popen(command, shell=False, stdout=subprocess.PIPE, encoding="ISO-8859-1")

while True:
    output = process.stdout.readline()

    if process.poll() is not None:
        break
    if output:
        print(output.strip())

BoltLogMessage("Finished backup")

# EndOp
