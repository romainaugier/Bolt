# BeginOp

import os

cacheFilesRemoved = 0
backupFilesRemoved = 0

for root, dirs, files in os.walk(indirectory):
    for file in files:
        filename, ext = os.path.splitext(file)

        filepath = os.path.join(root, file)
        filepath = filepath.replace("/", "\\")

        # Caches
        if "vdb" in ext or "bgeo.sc" in file:
            os.remove(filepath)

            cacheFilesRemoved += 1

        # Backup
        if "bak" in filename and "hipnc" in ext and "backup" in filepath:
            os.remove(filepath)
            
            backupFilesRemoved += 1

BoltLogMessage(f"Removed {cacheFilesRemoved} cache files")
BoltLogMessage(f"Removed {backupFilesRemoved} backup files")
# EndOp
