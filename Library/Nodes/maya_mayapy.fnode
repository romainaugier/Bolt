// Calls mayapy.exe with a generated script file passed in the first input

# BeginAttr

name = Maya_MayaPy
color = [33, 163, 165]
icon = $FLASH_ICONS/maya.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inscript
longName = Input Script Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# EndPlugs

# BeginOp

import subprocess

FlashLogMessage(f"MayaPy : Start executing script : {inscript}")

process = subprocess.Popen(["mayapy", inscript], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"MayaPy : Finished executing script : {inscript}")
    FlashLogMessage(stdoutAsStr)

# EndOp