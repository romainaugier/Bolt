// Calls mayapy.exe with a generated script file passed in the first input

# BeginAttr

name = MayaPy
inputs = 1
outputs = 0
color = [33, 163, 165]
icon = D:/dev/Flash/Library/Icons/maya.png

# EndAttr

# BeginOp

import subprocess

FlashLogMessage(f"MayaPy : Start executing script : {input0}")

process = subprocess.Popen(["mayapy", input0], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"MayaPy : Finished executing script : {input0}")
    FlashLogMessage(stdoutAsStr)

# EndOp