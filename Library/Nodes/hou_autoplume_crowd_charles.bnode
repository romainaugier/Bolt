# BeginOp

import os, subprocess, shutil, re

localSSDCache = ClientUtils.GetRoamingDataDir().replace("\\", "/")

if inusedtocache:
    localCachePath = "D:/"
else:
    localCachePath = localSSDCache
    
localAnimFile = f"{localSSDCache}/{os.path.basename(inanimationfile)}"

BoltLogMessage("Copying animation file to local cache")

ClientUtils.SafeCopy(inanimationfile, localAnimFile)

BoltLogMessage(f"Copied file to local cache ({localAnimFile})")

fr = inshotspecs["FrameRange"].split("-")
framerange = [int(fr[0]), int(fr[1])]

localCacheDir = f"{localCachePath}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/CrowdCharles"

if inmultiplefiles:
    cacheDir = f"{incachedir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/CrowdCharles1"
    localCacheDirFeathers = f"{localCachePath}/feathers/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/CrowdCharles1"

    while os.path.exists(cacheDir):   
        numPattern = r"(\d+)$"

        match = re.search(numPattern, cacheDir)

        value = int(match.group()) + 1

        cacheDir = f"{cacheDir[:match.start()]}{value}"

    while os.path.exists(localCacheDirFeathers):   
        numPattern = r"(\d+)$"

        match = re.search(numPattern, localCacheDirFeathers)

        value = int(match.group()) + 1

        localCacheDirFeathers = f"{localCacheDirFeathers[:match.start()]}{value}"

else:
    cacheDir = f"{incachedir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/CrowdCharles"
    localCacheDirFeathers = f"{localCachePath}/feathers/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/CrowdCharles"

if not os.path.exists(cacheDir):
    os.makedirs(cacheDir)

if not os.path.exists(localCacheDirFeathers):
    os.makedirs(localCacheDirFeathers)

generatedScript = f"""import hou, sys, os, shutil, subprocess

def copy(src, dst):
    if os.path.isfile(src):
        srcDir = os.path.dirname(src)
    else:
        srcDir = src
    if os.path.isfile(dst):
        dstDir = os.path.dirname(dst)
    else:
        dstDir = dst

    print("Copy : {{}} {{}}".format(srcDir, dstDir))

    command = []
    command.append("robocopy")
    command.append(srcDir)
    command.append(dstDir)
    command.append("/MT:32")
    command.append("/s")
    command.append("/J")
    command.append("/z")
    
    p = subprocess.Popen(command)
    
    p.wait()

hou.hipFile.load("{intemplatefile}")

hou.playbar.setFrameRange({framerange[0]}, {framerange[1]})

animSopNode = None
plumeSopNode = None
crowdSplitter = None
crowdCache = None
crowdCount = 0

for node in hou.node("/obj").children():
    if node.name() == "anim_import":
        animSopNode = node
    elif node.name() == "EXPORT":
        plumeSopNode = node

if animSopNode is not None and plumeSopNode is not None:
    for node in animSopNode.children():
        if node.name() == "alembic_import_crowd":
            node.parm("fileName").set("{localAnimFile}")
        elif node.name() == "CROWD_SPLIT":
            crowdSplitter = node
        elif node.name() == "CROWD_COUNT":
            crowdCount = node.geometry().attribValue("crowdCount")
        elif node.name() == "CROWD_CACHE":
            crowdCache = node

if animSopNode is not None and plumeSopNode is not None and crowdSplitter is not None and crowdCache is not None:
    print("Starting cache splitting...\\n")

    for i in range({framerange[0]}, {framerange[1] + 1}):
        print("Splitting frame {{}}...\\n".format(i))
        hou.setFrame(i)

        for j in range(crowdCount):
            try:
                crowdSplitter.parm("birdid").set(j)
                crowdCachePath = "{localCacheDir}/geo_temp/crowdChar{{}}_GeoCache.{{}}.bgeo.sc".format(j, i)
                crowdCache.parm("file").set(crowdCachePath)
                crowdCache.parm("trange").set(0)
                crowdCache.parm("execute").pressButton()
            except hou.Error as err:
                sys.stderr.write("Error : could not cache {{}}\\n".format(crowdCachePath))
                sys.stderr.write("{{}}\\n".format(err.instanceMessage()))

    print("Starting fur and feathers cache export...\\n")

    crowdCache.parm("loadfromdisk").set(1)

    for i in range(crowdCount):
        print("Exporting fur and feathers cache for bird {{}}...\\n".format(i))
        crowdCachePath = "{localCacheDir}/geo_temp/crowdChar{{}}_GeoCache.$F.bgeo.sc".format(i)
        crowdCache.parm("file").set(crowdCachePath)
        
        try:
            for node in plumeSopNode.children():
                if node.name() == "rop_alembic_fur" and {inexportfur}:
                    node.parm("filename").set("{localCacheDirFeathers}/{inshotspecs['Sequence']}_{inshotspecs['Shot']}_crowd_charles{{}}_cache_fur.abc".format(i))
                    node.parm("f1").set({framerange[0]})
                    node.parm("f2").set({framerange[1]})
                    node.parm("execute").pressButton()
                if node.name() == "rop_alembic_plumes":
                    node.parm("filename").set("{localCacheDirFeathers}/{inshotspecs['Sequence']}_{inshotspecs['Shot']}_crowd_charles{{}}_cache_plumes.abc".format(i))
                    node.parm("f1").set({framerange[0]})
                    node.parm("f2").set({framerange[1]})
                    node.parm("execute").pressButton()
        except hou.Error as err:
            sys.stderr.write("Error : could not write cache to disk {{}}\\n".format(crowdCachePath))
            sys.stderr.write("{{}}\\n".format(err.instanceMessage()))


print("Copying cache to network")

copy("{localCacheDirFeathers}", "{cacheDir}")

print("Cache copied to network")

hou.hipFile.clear()

try:
    os.remove("{localAnimFile}")
    # shutil.rmtree("{localCacheDir}")
except:
    pass
"""

tmpScriptFilePath = BoltTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath
outabccachedir = cacheDir

# EndOp
