# BeginOp

# BeginOp

import subprocess, os

BoltLogMessage(f"NukeBatch : Start executing script : {inscriptfile}")

command = [f"{innukebindir}", "-t", inscriptfile]

for arg in inargs:
    command.append(arg)

BoltLogMessage(f"NukeBatch Command : {' '.join(command)}")

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, encoding="ISO-8859-1")

stdout = []

while True:
    output = process.stdout.readline()

    if process.poll() is not None:
        break
    if output:
        stdout.append(output)
        print(output.strip())

for line in stdout:
    if line.startswith("OUTPUTFILE"):
        outfile = line.split("=")[1].strip()

BoltLogMessage(f"NukeBatch : Finished executing script")

# EndOp
