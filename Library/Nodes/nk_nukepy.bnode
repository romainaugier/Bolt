# EndPlug

# BeginPlug

shortName = inargs
longName = Script Arguments
defaultValue = []
type = list
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = innukebindir
longName = Nuke Binary Directory
defaultValue = "C:/Program Files/Nuke13.0v5/Nuke13.0.exe"
type = str
