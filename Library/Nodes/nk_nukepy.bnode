# BeginOp

# BeginOp

import subprocess, os

BoltLogMessage(f"NukeBatch : Start executing script : {inscriptfile}")

command = [f"{innukebindir}", "-t", inscriptfile]

for arg in inargs:
    command.append(arg)

BoltLogMessage(f"NukeBatch Command : {' '.join(command)}")

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, encoding="utf-8")
stdout, stderr = process.communicate()

try:
    stdoutAsStr = stdout
    stderrAsStr = stderr

    if len(stderrAsStr) > 0:
        BoltLogError(stderrAsStr)
    else:
        BoltLogMessage(f"NukeBatch : Finished executing script")
        BoltLogMessage(stdoutAsStr)

        for line in stdoutAsStr.splitlines():
            if line.startswith("OUTPUTFILE"):
                outfile = line.split("=")[1].strip()
except Exception as e:
    BoltLogMessage(e)

# EndOp
