exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inhoufile
longName = Input Houdini File
defaultValue = ""
type = str
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = output
longName = Output
defaultValue = None
type = custom
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# EndPlugs

# BeginOp

import subprocess, os, sys

BoltLogMessage(f"Hython : Start executing script : {inscript}")

command = ["hython"]

if os.path.exists(inhoufile):
    command.append(inhoufile)

command.append(inscript)

BoltLogMessage(f"Hython Command : {' '.join(command)}")

process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, encoding="utf-8")

while process.poll() is None:
    output = process.stdout.readline()
    errput = process.stderr.readline()

    if len(errput) > 0:
        BoltLogError(errput)
        BoltLogError(f"Hython error, terminating subprocess. Check the log for more details")
        sys.stderr.flush()
        process.terminate()
        break
    elif output:
        print(output.strip(), flush=True)

BoltLogMessage(f"Hython : Finished executing script : {inscript}")

# EndOp