# BeginOp

from datetime import datetime
import re, os, subprocess, platform, ast

now = datetime.now()
currentTimeStr = now.strftime('%m%d%Y_%H%M%S')

# Setup job and batch name
teamName = inrenderoptions["Team"]
jobType = inrenderoptions["Type"]
sequenceName = inrenderoptions["SequenceName"] 
shotName = inrenderoptions["ShotName"]
frameRange = inrenderoptions["FrameRange"]
adaptiveThreshold = inrenderoptions["AdaptiveThreshold"]
denoise = inrenderoptions["Denoise"]

jobName = f"{teamName}_{jobType}_{sequenceName}_{shotName}"
batchName = f"{jobName}-{currentTimeStr}"

if jobType == "LD":
    injoboptions["Priority"] = 50
elif jobType == "FML":
    injoboptions["Priority"] = 75

    frame1 = frameRange.split("-")[0]
    frame3 = frameRange.split("-")[1]
    frame2 = int(int(frame3) / 2)

    frameRange = f"{frame1} {frame2} {frame3}"
elif jobType == "HD":
    injoboptions["Priority"] = 25

renderDir = f"{inrenderdir}/{sequenceName}/{shotName}/{jobType}1"

while os.path.exists(renderDir):   
    numPattern = r"(\d+)$"

    match = re.search(numPattern, renderDir)

    value = int(match.group()) + 1

    renderDir = f"{renderDir[:match.start()]}{value}"

os.makedirs(renderDir)
BoltLogMessage(f"RenderDir : {renderDir}")

renderFile = f"{renderDir}/render_{sequenceName}_{shotName}_$f.$x"
openExrIdFile = f"{renderDir}/render_{sequenceName}_{shotName}_id_$f.$x"

renderFileMultipleLayers = f"{renderDir}/$n/render_{sequenceName}_{shotName}_$f.$x"
openExrIdFileMultipleLayers = f"{renderDir}/$n/render_{sequenceName}_{shotName}_id_$f.$x"

# Setup job options
injoboptions["Plugin"] = "Guerilla"
injoboptions["Name"] = jobName
injoboptions["BatchName"] = batchName
injoboptions["Frames"] = frameRange
injoboptions["OutputDirectory0"] = renderDir

# Render Job Infos
generatedRenderJobInfos = ""

for key, item in injoboptions.items():
    generatedRenderJobInfos += f"{key}={item}\n"

# Ribgen Job Infos
injoboptions["Name"] = f"{jobName}_ribgen"
injoboptions["Frames"] = 0

generatedRibgenJobInfos = ""

for key, item in injoboptions.items():
    generatedRibgenJobInfos += f"{key}={item}\n"

# Generate Guerilla script

boltTmpDir = BoltTempDir().replace("\\", "/")

generatedScript = f"""import guerilla, os, binascii
import RomanoTools.Guerilla.Utils as utils

renderPass = guerilla.Document().findchild("RenderPass")

layers = [child for child in guerilla.listchildren(renderPass) if isinstance(child, guerilla.RenderLayer)]

print("Found layers : \\n- {{}}".format("\\n- ".join([layer.Name.get() for layer in layers])))

aovs = {inrenderpasses}

for layer in layers:
    existingAovs = [aov.PlugName.get() for aov in layer.children()]

    aovsToAdd = {inrenderpasses}

    for aov in aovs:
        if aov in existingAovs:
            aovsToAdd.remove(aov)

    with guerilla.Modifier() as mod:
        for aov in aovsToAdd:
            layer.addaov(aov)

    print("Layer : {{}}".format(layer))
    print("AOVs : \\n- {{}}".format("\\n- ".join([aov.PlugName.get() for aov in layer.children()])))

with guerilla.Modifier() as mod:

    for layer in layers:
        for aov in layer.children():
            if aov.PlugName.get() == "Albedo":
                aov.OverrideSettings.set(True)
                aov.DisplayDriver.set("exrid")

                if len(layers) > 1:
                    aov.FileName.set("{openExrIdFileMultipleLayers}")
                else:
                    aov.FileName.set("{openExrIdFile}")

    utils.SetRange("{frameRange}")
    # utils.SetOptims()

    if "{jobType}" == "LD":
        utils.SetLowRenderParms()
    else:
        utils.SetFinalRenderParms(adaptiveThreshold={adaptiveThreshold}, denoise={denoise})

        print("Set final adaptive threshold : {adaptiveThreshold}")
        print("Set Denoiser : {{}}".format({denoise}))

    prefNode = guerilla.Document().findchild("Preferences")

    prefNode.RenderfarmSequence.set("{jobName}")
    prefNode.DeferredRibGen.set(True)

    renderPass = guerilla.Document().findchild("RenderPass")
    
    if len(layers) > 1:    
        renderPass.FileName.set("{renderFileMultipleLayers}")
    else:
        renderPass.FileName.set("{renderFile}")
    
    renderPass.DisplayDriver.set("exr")

sceneDir = guerilla.envcontext.getenv("SCENE_PATH")
jobsDir = "{{}}/jobs".format(sceneDir)

options = guerilla.renderoptions({{}})

options["JobsDirectory"] = jobsDir
options["DeferredRibGenBatch"] = {inribgenbatchsize}
options["DeferredFile"] = "{{}}/{{}}_ribgen_{{}}.gproject".format(jobsDir, options["FilePrefix"], options["RenderId"])

scriptFiles = guerilla.render("none", options)

tmpDirPath = "{boltTmpDir}"

ribgenJobInfoFiles = []
ribgenJobPluginFiles = []
renderJobInfoFiles = []
renderJobPluginFiles = []

for scriptFile in scriptFiles:
    args = scriptFile.getscriptargs(0)
    file = scriptFile.getscriptfile(0)

    randomStr = binascii.hexlify(os.urandom(6))

    if "ribgen" in file:
        ribgenJobInfoFile = "{{}}/ribgen_job_info_{{}}.job".format(tmpDirPath, randomStr)

        with open(ribgenJobInfoFile, "w") as f:
            f.write(\"\"\"{generatedRibgenJobInfos}\"\"\")

        ribgenJobInfoFiles.append(ribgenJobInfoFile)

        ribgenJobPluginFile = "{{}}/ribgen_plugin_info_{{}}.job".format(tmpDirPath, randomStr)

        with open(ribgenJobPluginFile, "w") as f:
            f.write(\"\"\"ScriptFile={{}}/{{}}\nScriptArgs=\\\"{{}}\\\"\"\"\".format(jobsDir, file, args[0]))

        ribgenJobPluginFiles.append(ribgenJobPluginFile)
    else:
        renderJobInfoFile = "{{}}/render_job_info_{{}}.job".format(tmpDirPath, randomStr)

        with open(renderJobInfoFile, "w") as f:
            f.write(\"\"\"{generatedRenderJobInfos}\"\"\")

        renderJobInfoFiles.append(renderJobInfoFile)

        renderJobPluginFile = "{{}}/render_plugin_info_{{}}.job".format(tmpDirPath, randomStr)

        with open(renderJobPluginFile, "w") as f:
            f.write(\"\"\"ScriptFile={{}}/{{}}\nScriptArgs=\\\"{{}}\\\"\"\"\".format(jobsDir, file, args[0]))

        renderJobPluginFiles.append(renderJobPluginFile)

print("RIBGEN_JOB_INFO_FILES={{}}".format(ribgenJobInfoFiles))
print("RIBGEN_JOB_PLUGIN_FILES={{}}".format(ribgenJobPluginFiles))
print("RENDER_JOB_INFO_FILES={{}}".format(renderJobInfoFiles))
print("RENDER_JOB_PLUGIN_FILES={{}}".format(renderJobPluginFiles))

guerilla.Document().save()
"""

# Start the guerilla scene and execute the script to prepare it

tmpScriptFilePath = BoltTempScript()
with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

BoltLogMessage(f"GuerillaBatch : Start executing script : {tmpScriptFilePath}")

if platform.system() == "Windows":
    command = [f"{inenvironment['GUERILLA']}/guerillaBatch", "--nogui"] 
    
    if os.path.exists(inguerillafile):
        command.append(inguerillafile)
    
    command.append(tmpScriptFilePath)
else:
    command = [f"{inenvironment['GUERILLA']}/guerilla", "--nogui"]

    if os.path.exists(inguerillafile):
        command.append(inguerillafile)
    
    command.append(tmpScriptFilePath)

BoltLogMessage(f"GuerillaBatch Command : {' '.join(command)}")

env = os.environ.copy()
env.update(inenvironment)

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env)

stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    BoltLogError(stderrAsStr)
else:
    BoltLogMessage(f"GuerillaBatch : Finished executing script : {tmpScriptFilePath}")
    BoltLogMessage(stdoutAsStr)

# Get the generated guerilla scriptfiles paths

ribgenJobInfoPattern = r"RIBGEN_JOB_INFO_FILES=(\S+)"
ribgenJobPluginPattern = r"RIBGEN_JOB_PLUGIN_FILES=(\S+)"
renderJobInfoPattern = r"RENDER_JOB_INFO_FILES=(\S+)"
renderJobPluginPattern = r"RENDER_JOB_PLUGIN_FILES=(\S+)"

stdoutAsStr = re.sub(r"(,)\s(\S)", r"\g<1>\g<2>", stdoutAsStr)

ribgenJobInfoFileList = re.findall(ribgenJobInfoPattern, stdoutAsStr)[0]
ribgenJobPluginFileList = re.findall(ribgenJobPluginPattern, stdoutAsStr)[0]
renderJobInfoFileList = re.findall(renderJobInfoPattern, stdoutAsStr)[0]
renderJobPluginFileList = re.findall(renderJobPluginPattern, stdoutAsStr)[0]

outribgenjobinfofiles = ast.literal_eval(ribgenJobInfoFileList.replace(" ", ""))
outribgenplugininfofiles = ast.literal_eval(ribgenJobPluginFileList.replace(" ", ""))
outrenderjobinfofiles = ast.literal_eval(renderJobInfoFileList.replace(" ", ""))
outrenderplugininfofiles = ast.literal_eval(renderJobPluginFileList.replace(" ", ""))
outrenderdir = renderDir

# EndOp
