// Output a float constant

# BeginAttr 

name = Float
category = Maths

# EndAttr

# BeginPlugs

# BeginPlug 

shortName = infloat
longName = Value
defaultValue = 0.0
type = float
exposed = True

# EndPlug

# BeginPlug 

shortName = outfloat
longName = Output Float
defaultValue = 0.0
type = float

# EndPlug

# EndPlugs

# BeginOp

outfloat = infloat

# EndOp