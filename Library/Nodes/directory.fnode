// Look for a dir and returns it

# BeginAttr

name = Directory
color = [255, 220, 106]
category = Utility
icon = $FLASH_ICONS/folder.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = indir
longName = Input Directory Path
defaultValue = ""
type = str
exposed = True

# EndPlug

# BeginPlug

shortName = outdir
longName = Output Directory Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# EndPlugs

# BeginOp

outdir = indir

# EndOp