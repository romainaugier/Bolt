// Look for a dir and returns it

# BeginAttr

name = Directory
inputs = 0
outputs = 1
color = [255, 220, 106]

# EndAttr

# BeginPlugs

# BeginPlug

shortName = indir
longName = Input Directory Path
defaultValue = ""
type = str
isExposed = True

# EndPlug

# BeginPlug

shortName = outdir
longName = Output Directory Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# EndPlugs

# BeginOp

outdir = indir

# EndOp