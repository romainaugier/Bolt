// Generates a script to create a houdini file to generate an ocean given a camera and a plane, and a framerange

# BeginAttr

name = Hou_AutoOcean
icon = $BOLT_ICONS/houdini.png
category = Houdini

# EndAttr

# BeginPlugs

# BeginPlug

shortName = incameraabcfile
longName = Input Camera File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inplanefile
longName = Alembic Water Plane File Path
defaultValue = ""
type = str

# EndPlug

# BeginPlug

shortName = inshotspecs
longName = Shot Specs
defaultValue = {}
type = dict
exposed = False

# EndPlug

# BeginPlug

shortName = infxdir
longName = FX Directory
defaultValue = "$FX_DIR"
type = dict
exposed = False

# EndPlug

# BeginPlug

shortName = outwaterplanefile
longName = Output Water Plane File
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

framerange = inshotspecs["FrameRange"].split("-")

outputfilename = f"{inshotspecs['Sequence'].tolower()}_{inshotspecs['Shot'].tolower()}_water_plane"
outputabcfile = f"{infxdir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/ocean/export/abc/{outputfilename}.abc"
outputhoufile = f"{infxdir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/ocean/{outputfilename}.hou"

if not os.path.exists(outputhoufile):
    os.makedirs(outputhoufile)

BoltLogMessage(f"Output file : {outputhoufile}")

generatedScript = f"""import hou

abcCamNode = None
waterNode = None

for node in hou.node("/obj").children():
    if node.name() == "CAM":
        abcCamNode = node
    elif node.name() == "WATER":
        waterNode = node

if abcCamNode != None:
    abcCamNode.parm("fileName").set("{incameraabcfile}")
    abcCamNode.parm("buildHierarchy").pressButton()

    print("Input Camera : {{}}".format("{incameraabcfile}"))

camera = hou.nodeType(hou.objNodeTypeCategory(),"cam").instances()[0]

if waterNode != None:
    for node in waterNode.children():
        if node.type().name() == "alembic":
            node.parm("fileName").set("{inplanefile}")

    for node in waterNode.children():
        if node.type().name() == "rop_alembic":
            node.parm("filename").set("{outputabcfile}")
            node.parm("f1").set({framerange[0]})
            node.parm("f2").set({framerange[1]})
"""

tmpScriptFilePath = BoltTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath

# EndOp