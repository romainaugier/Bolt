// Returns a list of files

# BeginAttr

name = Files
color = [255, 220, 106]
category = Utility
icon = $FLASH_ICONS/files.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = infiles
longName = Input Files Path
defaultValue = ""
type = list
exposed = True

# EndPlug

# BeginPlug

shortName = outfiles
longName = Output Files Path
defaultValue = ""
type = list
exposed = False

# EndPlug

# EndPlugs

# BeginOp

outfiles = infiles

# EndOp