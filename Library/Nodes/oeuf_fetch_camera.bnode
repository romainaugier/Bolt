// Node Definition automatically generated by Bolt

# BeginAttr

name = Oeuf_FetchCamera
category = Oeuf
color = [0, 0, 0]
icon = $BOLT_ICONS/camera.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inshotspecs
longName = Shot Specs
defaultValue = {}
type = dict
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inanimationdir
longName = Animation Directory Path
defaultValue = "$ANIM_DIR"
type = str
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = outcampath
longName = Camera Path
defaultValue = ""
type = str
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# EndPlugs

# BeginOp

import os

sequence = inshotspecs["Sequence"]
shot = inshotspecs["Shot"]
camDir = f"{inanimationdir}/{sequence}/{shot}/cam"

camLastVersionDir = ClientUtils.GetLastVersionDir(camDir)
fileCount = len(os.listdir(camLastVersionDir))

if fileCount == 0:
    BoltLogError(f"No file is available in directory '{camLastVersionDir}'")
elif fileCount > 1:
    BoltLogWarning(f"More than one file has been found in directory '{camLastVersionDir}'")
    outcampath = f"{camLastVersionDir}/{os.listdir(camLastVersionDir)[0]}"
else:
    outcampath = f"{camLastVersionDir}/{os.listdir(camLastVersionDir)[0]}"

# EndOp
