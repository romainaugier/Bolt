// Merges two nodes and outputs data combined in a list

# BeginAttr

name = Merge
icon = $FLASH_ICONS/merge.png
category = Utility

# EndAttr

# BeginPlugs

# BeginPlug

shortName = input1
longName = Input 1
defaultValue = None
type = custom
exposed = False

# EndPlug

# BeginPlug

shortName = input2
longName = Input 2
defaultValue = None
type = custom
exposed = False

# EndPlug

# BeginPlug

shortName = output
longName = Output
defaultValue = []
type = list

# EndPlug

# EndPlugs

# BeginOp

if type(input1) is list:
    if type(input2) is list:
        output = [*input1, *input2]
    else:
        output = [*input1, input2]
elif type(input2) is list:
    output = [input1, *input2]
else:
    output = [input1, input2]

# EndOp