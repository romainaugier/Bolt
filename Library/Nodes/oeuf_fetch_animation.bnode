// Node Definition automatically generated by Bolt

# BeginAttr

name = Oeuf_FetchAnimation
category = Oeuf
color = [0, 0, 0]
icon = $BOLT_ICONS/animation.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inshotspecs
longName = Shot Specs
defaultValue = {}
type = dict
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inanimationdir
longName = Animation Directory Path
defaultValue = "$ANIM_DIR"
type = str
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inanimtofetch
longName = Animation To Fetch
defaultValue = ["CHARLES", "CORINNE", "OEUFS"]
type = list
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = outanimpaths
longName = Animations Path
defaultValue = []
type = list
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# EndPlugs

# BeginOp

import os, re

sequence = inshotspecs["Sequence"]
shot = inshotspecs["Shot"]
animDir = f"{inanimationdir}/{sequence}/{shot}"

charlesMatches = ["CHARLES", "Charles", "charles"]
corinneMatches = ["CORINNE", "Corinne", "corinne"]
oeufsMatches = ["OEUFS", "OEUF", "Oeufs", "Oeuf", "oeufs", "oeuf"]

fetchCharles = False
fetchCorinne = False
fetchOeufs = False

for item in inanimtofetch:
    if item in charlesMatches:
        fetchCharles = True
    elif item in corinneMatches:
        fetchCorinne = True
    elif item in oeufsMatches:
        fetchOeufs = True

outanimpaths = []

for dir in os.listdir(animDir):
    if fetchCharles:
        if dir in charlesMatches:
            charlesDirPath = f"{animDir}/{dir}"
            lastVersionDir = ClientUtils.GetLastVersionDir(charlesDirPath)

            fileCount = len(os.listdir(lastVersionDir))

            if fileCount == 0:
                BoltLogError(f"No animation export of Charles is available in directory '{lastVersionDir}'")
            elif fileCount > 1:
                BoltLogWarning(f"More than one file exists in directory '{lastVersionDir}'. Using the first available")
                charlesAnimPath = f"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}"
                outanimpaths.append(charlesAnimPath)
            else:
                charlesAnimPath = f"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}"
                outanimpaths.append(charlesAnimPath)
            
            continue
    if fetchCorinne:
        if dir in corinneMatches:
            corinneDirPath = f"{animDir}/{dir}"
            lastVersionDir = ClientUtils.GetLastVersionDir(corinneDirPath)

            fileCount = len(os.listdir(lastVersionDir))

            if fileCount == 0:
                BoltLogError(f"No animation export of Corinne is available in directory '{lastVersionDir}'")
            elif fileCount > 1:
                BoltLogWarning(f"More than one file exists in directory '{lastVersionDir}'. Using the first available")
                corinneAnimPath = f"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}"
                outanimpaths.append(corinneAnimPath)
            else:
                corinneAnimPath = f"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}"
                outanimpaths.append(corinneAnimPath)
            
            continue
    if fetchOeufs:
        oeufPattern = re.compile(r".*OEUF.*|.*Oeuf.*|.*oeuf.*|.*OEUFS.*|.*Oeufs.*|.*oeufs.*")

        if re.search(oeufPattern, dir):
            oeufDirPath = f"{animDir}/{dir}"
            lastVersionDir = ClientUtils.GetLastVersionDir(oeufDirPath)

            fileCount = len(os.listdir(lastVersionDir))

            if fileCount == 0:
                BoltLogError(f"No animation export of oeuf is available in directory '{lastVersionDir}'")
            elif fileCount > 1:
                BoltLogWarning(f"More than one file exists in directory '{lastVersionDir}'. Using the first available")
                oeufAnimPath = f"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}"
                outanimpaths.append(oeufAnimPath)
            else:
                oeufAnimPath = f"{lastVersionDir}/{os.listdir(lastVersionDir)[0]}"
                outanimpaths.append(oeufAnimPath)
            
            continue

# EndOp