# BeginAttr

name = NK_CopyCompToLocal
icon = $BOLT_ICONS/nuke.png
category = Nuke

# EndAttr

# BeginPlugs

# BeginPlug

shortName = incompfile
longName = Compositing file
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = incheckfiles
longName = Check if files are already local
defaultValue = True
type = bool
exposed = True

# EndPlug

# BeginPlug

shortName = outscriptfile
longName = Script File
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

import os, shutil

fileName, fileExt = os.path.splitext(os.path.basename(incompfile))

localDir = f"D:/LOCAL_COMP/{fileName}"
localFile = f"{localDir}/{fileName}{fileExt}"

if not os.path.exists(localDir):
    os.makedirs(localDir)

shutil.copy2(incompfile, localFile)

generatedScript = f"""import nuke, os, sys, subprocess, re

print("Opening {localFile}")

nuke.scriptOpen("{localFile}")

localCache = "{localDir}/dependencies"
files = {{}}
threadCount = int(os.getenv("NUMBER_OF_PROCESSORS"))

def isLocal(path):
    if (path.startswith("D:/") or
        path.startswith("C:/") or 
        path.startswith("E:/") or 
        path.startswith("G:/")):
        return True
    
    return False

def fileExists(fileName):
    localDirList = ["D:/", "E:/", "G:/", "C:/"]

    for dir in localDirList:
        if not os.path.exists(dir): continue

        os.chdir(dir)
        
        p = subprocess.check_output("dir /b /s {{}}".format(fileName), shell=True)

        stdout = p.decode()

        stdout = stdout.replace("\\\\", "/")
        stdout = stdout.replace("\\r", "")

        stdoutSplit = stdout.split("\\n")

        for f in stdoutSplit:
            if fileName in f:
                return f

    return None

def makeLocalPath(path):
    global localCache

    pathSplit = path.split("/")

    newPath = "{{}}/{{}}".format(localCache, "/".join(pathSplit[2:]))

    return newPath

print("Looking for read nodes...")

for node in nuke.allNodes():
    if node.Class() == "Read" or node.Class() == "DeepRead":
        print("Found Read : {{}}".format(node["name"].value()))

        file = node.knob("file").getValue()
        
        if {incheckfiles}:
            fExists = fileExists(os.path.basename(file))
        
            if fExists is not None:
                node.knob("file").setValue(fExists)
                
        elif isLocal(file): continue

        elif not file in files:
            localFile = makeLocalPath(file)
            files[file] = localFile
            node.knob("file").setValue(localFile)
        else:
            node.knob("file").setValue(files[file])

fileSeqPattern = r"\#+|%\d+d"

depsFmt = "\\n".join([file for file in files.keys()])

print("File dependencies found : {{}}".format(depsFmt))

for file, localFile in files.items():
    fileName = os.path.basename(file)

    filesDir = os.path.dirname(file)
    localDir = os.path.dirname(localFile)

    if not os.path.exists(localDir): 
        os.makedirs(localDir)

    command = []
    command.append("robocopy")
    command.append(filesDir)
    command.append(localDir)

    filesPattern = re.sub(fileSeqPattern, "*", fileName)

    command.append(filesPattern)

    command += ["/J", "/Z", "/MT:{{}}".format(threadCount), "/s"]

    print("Copying {{}} -> {{}}".format(file, localFile))

    subprocess.call(command)

nuke.scriptSave("{localFile}")

"""

tmpScriptFilePath = BoltTempScript()

with open(tmpScriptFilePath, "w") as file:
    file.write(generatedScript)

outscriptfile = tmpScriptFilePath

# EndOp
