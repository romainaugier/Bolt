// Returns the environment used by Oeuf team to launch Guerilla

# BeginAttr

name = Oeuf_GuerillaEnv
icon = $BOLT_ICONS/volcan.png
category = Oeuf

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inenvironment
longName = Environment
defaultValue = { "GUERILLA" : "P:/GUERILLA/2.3.0.13_Romain", "GUERILLA_PYTHON_LIBRARY" : "P:/PYTHON/Python27_Romain/python27.dll;P:/PYTHON/Python27_Romain", "PYTHONHOME" : "P:/PYTHON/Python27_Romain", "PYTHONPATH" : "P:/PYTHON/Python27_Romain;P:/PYTHON/Python27_Romain/Lib", "PATH" : "%PYTHONHOME%;%PATH%", "DEADLINEPATH" : "C:/Program Files/Thinkbox/Deadline10;C:/Program Files/Thinkbox/Deadline10/bin", "OCIO" : "P:/COLOR/aces_1.2/config.ocio" }
type = dict
exposed = True

# EndPlug

# BeginPlug

shortName = outenvironment
longName = Output Environment
defaultValue = {}
type = dict

# EndPlug

# EndPlugs

# BeginOp

outenvironment = inenvironment

# EndOp