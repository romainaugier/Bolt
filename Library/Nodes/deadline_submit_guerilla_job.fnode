// Submits a guerilla job to deadline using : 
// deadlinecommand -Multi -job ribgen_job_info.job ribgen_plugin_info.job -job -dependsOnPrevious render_job_info.job render_plugin_info.job
// and outputs the job id if the job has been submitted successfully

# BeginAttr

name = Deadline_SubmitGuerillaJob
icon = $FLASH_ICONS/deadlinelogo.png
category = Deadline

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inribgenjobinfo
longName = Ribgen Job Info File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inribgenplugininfo
longName = Ribgen Plugin Info File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inrenderjobinfo
longName = Render Job Info File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inrenderplugininfo
longName = Render Plugin Info File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = outribgenjobid
longName = Ribgen Job ID
defaultValue = ""
type = str

# EndPlug

# BeginPlug

shortName = outrenderjobid
longName = Render Job ID
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

import subprocess, re

jobRibgenName = ""
jobRenderName = ""

with open(inribgenjobinfo, "r") as file:
    for line in file.readlines():
        if line.startswith("Name"):
            jobRibgenName = line.split("=")[1]

with open(inrenderjobinfo, "r") as file:
    for line in file.readlines():
        if line.startswith("Name"):
            jobRenderName = line.split("=")[1]

FlashLogMessage(f"Deadline : Submitting ribgen job {jobRibgenName}")
FlashLogMessage(f"Deadline : Submitting render job {jobRenderName}")

command = [
    "deadlinecommand",
    "-Multi",
    "-job",
    inribgenjobinfo,
    inribgenplugininfo,
    "-job",
    "-dependsOnPrevious",
    inrenderjobinfo,
    inrenderplugininfo
]

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    jobIdPattern = r"JobID=(\S+)"

    matches = re.findall(jobIdPattern, stdoutAsStr)

    outribgenjobid = matches[0]
    outrenderjobid = matches[1]

    FlashLogMessage(f"Deadline : Finished submitting job. \n    Ribgen Job ID = {outribgenjobid}\n    Render Job ID = {outrenderjobid}")

    FlashLogMessage(stdoutAsStr)

# EndOp