// Generates a script to export a plume pointcloud given an animation

# BeginAttr

name = Hou_AutoPlume
icon = $FLASH_ICONS/houdini.png
category = Houdini

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inanimationabcfile
longName = Input Alembic Animation File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inoutputfilename
longName = Alembic Point Cloud File Path
defaultValue = ""
type = str

# EndPlug

# BeginPlug

shortName = inframerange
longName = Frame Range
defaultValue = [100, 240]
type = int2
exposed = True

# EndPlug

# BeginPlug

shortName = outscriptfile
longName = Output Script File
defaultValue = ""
type = str

# EndPlug

# BeginPlug

shortName = outabcfile
longName = Output Alembic Point Cloud File
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

generatedScript = f"""import hou

animSopNode = None
plumeSopNode = None

for node in hou.node("/obj").children():
    if node.name() == "anim_import":
        animSopNode = node
    elif node.name() == "plume":
        plumeSopNode = node

if animSopNode != None:
    for node in animSopNode.children():
        if node.type().name() == "alembic":
            node.parm("fileName").set("{inanimationabcfile}")
            break

if plumeSopNode != None:
    for node in plumeSopNode.children():
        if node.type().name() == "rop_alembic":
            node.parm("filename").set("{inoutputfilename}")
            node.parm("f1").set({framerange[0]})
            node.parm("f2").set({framerange[1]})
            node.parm("execute").pressButton()
"""

tmpScriptFilePath = FlashTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

outscriptfile = tmpScriptFilePath

# EndOp