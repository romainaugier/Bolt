// Submits a job to deadline using deadlinecommand -job_info.job -plugin-info.job and outputs the job id 
// if the job has been submitted successfully

# BeginAttr

name = Deadline_SubmitJob
icon = $BOLT_ICONS/deadline.png
category = Deadline

# EndAttr

# BeginPlugs

# BeginPlug

shortName = injobinfo
longName = Job Info File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inplugininfo
longName = Plugin Info File
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = outjobid
longName = Job ID
defaultValue = ""
type = str

# EndPlug

# EndPlugs

# BeginOp

import subprocess, re

jobName = ""

with open(injobinfo, "r") as file:
    for line in file.readlines():
        if line.startswith("Name"):
            jobName = line.split("=")[1]

BoltLogMessage(f"Deadline : Submitting job {jobName}")

process = subprocess.Popen(["deadlinecommand", injobinfo, inplugininfo], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    BoltLogError(stderrAsStr)
else:
    jobIdPattern = r"JobID=(\S+)"

    match = re.search(jobIdPattern, stdoutAsStr)

    outjobid = match.group(0).replace("JobID=", "")

    BoltLogMessage(f"Deadline : Finished submitting job. ID = {outjobid}")

    BoltLogMessage(stdoutAsStr)

# EndOp