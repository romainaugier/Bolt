// Generates render options for a low def render

# BeginAttr

name = Oeuf_RenderOptionsLD
icon = $BOLT_ICONS/volcan.png
category = Oeuf

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inrenderoptions
longName = Render Options
defaultValue = {"Type":"LD","Team":"oeuf","Optims":True}
type = dict
exposed = True

# EndPlug

# BeginPlug

shortName = inshotspecs
longName = Shot Specs
defaultValue = {}
type = dict
exposed = False

# EndPlug

# BeginPlug

shortName = outrenderoptions
longName = Output Render Options
defaultValue = {}
type = dict

# EndPlug

# EndPlugs

# BeginOp

outrenderoptions = inrenderoptions

if "Sequence" in inshotspecs:
    outrenderoptions["SequenceName"] = inshotspecs["Sequence"]
if "Shot" in inshotspecs:
    outrenderoptions["ShotName"] = inshotspecs["Shot"]
if "FrameRange" in inshotspecs:
    outrenderoptions["FrameRange"] = inshotspecs["FrameRange"]

# EndOp