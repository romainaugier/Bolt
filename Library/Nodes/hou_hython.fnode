// Calls hython.exe with a generated script file passed in the first input

# BeginAttr

name = Hython
inputs = 1
outputs = 0
color = [255, 87, 34]
icon = D:/dev/Flash/Library/Icons/houdini.png

# EndAttr

# BeginOp

import subprocess

FlashLogMessage(f"Hython : Start executing script : {input0}")

process = subprocess.Popen(["hython", input0], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"Hython : Finished executing script : {input0}")
    FlashLogMessage(stdoutAsStr)

# EndOp