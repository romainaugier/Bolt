# BeginOp

import subprocess, os

FlashLogMessage(f"Hython : Start executing script : {inscript}")

command = ["hython"]

if os.path.exists(inhoufile):
    command.append(inhoufile)

command.append(inscript)

FlashLogMessage(f"Hython Command : {' '.join(command)}")

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"Hython : Finished executing script : {inscript}")
    FlashLogMessage(stdoutAsStr)



# EndOp
