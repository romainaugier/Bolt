// Calls hython.exe with a generated script file passed in the first input

# BeginAttr

name = Hython
color = [255, 87, 34]
icon = $FLASH_ICONS/houdini.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inscript
longName = Input Script Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# EndPlugs

# BeginOp

import subprocess

FlashLogMessage(f"Hython : Start executing script : {inscript}")

process = subprocess.Popen(["hython", inscript], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"Hython : Finished executing script : {inscript}")
    FlashLogMessage(stdoutAsStr)

# EndOp