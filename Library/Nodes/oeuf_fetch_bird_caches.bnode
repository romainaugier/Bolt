// Node Definition automatically generated by Bolt

# BeginAttr

name = Oeuf_FetchBirdCaches
category = Oeuf
color = [0, 0, 0]
icon = $BOLT_ICONS/volcan.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inshotspecs
longName = Shot Specs
defaultValue = {}
type = dict
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = inbirds
longName = Birds
defaultValue = ["Charles", "Corinne"]
type = list
exposed = True

# EndPlug

# BeginPlug

shortName = incachedir
longName = Cache Directory Path
defaultValue = "Z:/OEUF/CACHE"
type = str
exposed = True
hidden = False
exposedToGraph = False

# EndPlug

# BeginPlug

shortName = outcachespath
longName = Caches Path
defaultValue = []
type = list
exposed = False
hidden = False
exposedToGraph = False

# EndPlug

# EndPlugs

# BeginOp

import os

sequence = inshotspecs["Sequence"]
shot = inshotspecs["Shot"]
cacheDir = f"{incachedir}/{sequence}/{shot}"

charlesMatches = ["CHARLES", "Charles", "charles"]
corinneMatches = ["CORINNE", "Corinne", "corinne"]

fetchCharles = False
fetchCorinne = False

for item in inbirds:
    if item in charlesMatches:
        fetchCharles = True
    elif item in corinneMatches:
        fetchCorinne = True

outcachespath = []

for dir in os.listdir(cacheDir):
    if fetchCharles:
        if dir in charlesMatches:
            charlesDirPath = f"{cacheDir}/{dir}"

            for file in os.listdir(charlesDirPath):
                if "fur" in file:
                    outcachespath.append(f"{charlesDirPath}/{file}")
                if "plumes" in file:
                    outcachespath.append(f"{charlesDirPath}/{file}")
            
            continue

    if fetchCorinne:
        if dir in corinneMatches:
            corinneDirPath = f"{cacheDir}/{dir}"

            for file in os.listdir(corinneDirPath):
                if "fur" in file:
                    outcachespath.append(f"{corinneDirPath}/{file}")
                if "plumes" in file:
                    outcachespath.append(f"{corinneDirPath}/{file}")
            
            continue

# EndOp
