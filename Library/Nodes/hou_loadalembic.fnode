// Generate a script to load an alembic file into a new or existing houdini scene

// input0 : alembic file to load

// output0 : generated script

# BeginAttr

name = Hou_LoadAlembic
inputs = 1
outputs = 1
color = [255, 87, 34]

# EndAttr

# BeginParms

# BeginParm

shortName = file
longName = Houdini File
defaultValue = ""

# EndParm

# EndParms

# BeginOp

generatedScript = f"""import hou, os

filename = os.path.splitext(os.path.basename("{input0}"))[0]
filepath = "{input0}"

if "{file}" != "" and os.path.exists("{file}"):
    hou.hipFile.load("{file}")

sopNode = hou.node("/obj").createNode("geo", "alembic_{{}}".format(filename))

abcNode = sopNode.createNode("alembic")
abcNode.parm("fileName").set(filepath)
abcNode.parm("loadmode").set(1)

convertNode = sopNode.createNode("convert")
convertNode.setInput(0, abcNode)

xformNode = sopNode.createNode("xform")
xformNode.setInput(0, convertNode)

nullNode = sopNode.createNode("null", "OUT_{{}}".format(filename))
nullNode.setInput(0, xformNode)

sopNode.layoutChildren()

if file != "":
    hou.hipFile.save("{file}")
"""

tmpScriptFilePath = FlashTempScript()

with open(tmpScriptFilePath, "w") as scriptFile:
    scriptFile.write(generatedScript)

output0 = tmpScriptFilePath.replace("\\", "/")

# EndOp