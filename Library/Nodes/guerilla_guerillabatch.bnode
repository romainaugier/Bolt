// Calls guerilla --nogui with a generated script file passed in the first input

# BeginAttr

name = Guerilla_GuerillaBatch
color = [52, 115, 165]
icon = $BOLT_ICONS/guerilla-render.png
category = Guerilla

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inscript
longName = Input Script Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inguerillafile
longName = Input Guerilla File
defaultValue = ""
type = str
exposed = True

# EndPlug

# BeginPlug

shortName = inenvironment
longName = Environment
defaultValue = { "GUERILLA" : "P:/GUERILLA/2.3.0.13_Romain", "GUERILLA_PYTHON_LIBRARY" : "P:/PYTHON/Python27_Romain/python27.dll", "PYTHONHOME" : "P:/PYTHON/Python27_Romain", "PYTHONPATH" : "P:/PYTHON/Python27_Romain/Lib", "PATH" : "%PYTHONHOME%;%PATH%", "DEADLINEPATH" : "C:/Program Files/Thinkbox/Deadline10;C:/Program Files/Thinkbox/Deadline10/bin", "OCIO" : "P:/COLOR/aces_1.2/config.ocio" }
type = dict
exposed = False

# EndPlug

# BeginPlug

shortName = output
longName = Output
defaultValue = ""
type = custom

# EndPlug

# EndPlugs

# BeginOp

import subprocess, platform, os

BoltLogMessage(f"GuerillaBatch : Start executing script : {inscript}")

if platform.system() == "Windows":
    command = [f"{inenvironment['GUERILLA']}/guerillaBatch", "--nogui"] 
    
    if os.path.exists(inguerillafile):
        command.append(inguerillafile)
    
    command.append(inscript)
else:
    command = [f"{inenvironment['GUERILLA']}/guerilla", "--nogui"]

    if os.path.exists(inguerillafile):
        command.append(inguerillafile)
    
    command.append(inscript)

BoltLogMessage(f"GuerillaBatch Command : {' '.join(command)}")

env = os.environ.copy()
env.update(inenvironment)

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env, encoding="ISO-8859-1")

while True:
    output = process.stdout.readline()

    if process.poll() is not None:
        break
    if output:
        print(output.strip())

if process.returncode != 0:
    BoltLogError("GuerillaBatch : Returned a non-zero return code")
else:
    BoltLogMessage(f"GuerillaBatch : Finished executing script : {inscript}")

# EndOp