// Opens Guerilla with a file and a script passed

# BeginAttr

name = Guerilla_StartGuerilla
color = [52, 115, 165]
icon = $BOLT_ICONS/guerilla-render.png
category = Guerilla

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inscript
longName = Input Script Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# BeginPlug

shortName = inguerillafile
longName = Input Guerilla File
defaultValue = ""
type = str
exposed = True

# EndPlug

# BeginPlug

shortName = inenvironment
longName = Environment
defaultValue = { "GUERILLA" : "P:/GUERILLA/2.3.0.13_Romain", "GUERILLA_PYTHON_LIBRARY" : "P:/PYTHON/Python27_Romain/python27.dll", "PYTHONHOME" : "P:/PYTHON/Python27_Romain", "PYTHONPATH" : "P:/PYTHON/Python27_Romain/Lib", "PATH" : "%PYTHONHOME%;%PATH%", "DEADLINEPATH" : "C:/Program Files/Thinkbox/Deadline10;C:/Program Files/Thinkbox/Deadline10/bin", "OCIO" : "P:/COLOR/aces_1.2/config.ocio" }
type = dict
exposed = False

# EndPlug

# BeginPlug

shortName = output
longName = Output
defaultValue = ""
type = custom

# EndPlug

# EndPlugs

# BeginOp

import subprocess, os

BoltLogMessage(f"Guerilla : Start session")

command = [f"{inenvironment['GUERILLA']}/guerilla"] 

if os.path.exists(inguerillafile):
    BoltLogMessage(f"Guerilla : File : {inguerillafile}")
    command.append(inguerillafile)

if os.path.exists(inscript):
    BoltLogMessage(f"Guerilla : Script : {inscript}")
    command.append(inscript)

BoltLogMessage(f"Guerilla Command : {' '.join(command)}")

env = os.environ.copy()
env.update(inenvironment)

process = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env)

stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    BoltLogError(stderrAsStr)
else:
    BoltLogMessage(f"Guerilla : Finished session")
    BoltLogMessage(stdoutAsStr)

# EndOp