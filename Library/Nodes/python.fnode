// Calls python.exe with a generated script file passed in the first input

# BeginAttr

name = Python
inputs = 1
outputs = 0
color = [52, 115, 165]
icon = D:/dev/Flash/Library/Icons/python.png

# EndAttr

# BeginOp

import subprocess

FlashLogMessage(f"Python : Start executing script : {input0}")

process = subprocess.Popen(["python", input0], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"python : Finished executing script : {input0}")
    FlashLogMessage(stdoutAsStr)

# EndOp