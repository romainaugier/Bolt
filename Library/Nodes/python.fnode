// Calls python.exe with a generated script file passed in the first input

# BeginAttr

name = Python
color = [52, 115, 165]
icon = D:/dev/Flash/Library/Icons/python.png

# EndAttr

# BeginPlugs

# BeginPlug

shortName = inscript
longName = Input Script Path
defaultValue = ""
type = str
exposed = False

# EndPlug

# EndPlugs

# BeginOp

import subprocess

FlashLogMessage(f"Python : Start executing script : {inscript}")

process = subprocess.Popen(["python", inscript], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
stdout, stderr = process.communicate()

stdoutAsStr = stdout.decode("utf-8")
stderrAsStr = stderr.decode("utf-8")

if len(stderrAsStr) > 0:
    FlashLogError(stderrAsStr)
else:
    FlashLogMessage(f"python : Finished executing script : {inscript}")
    FlashLogMessage(stdoutAsStr)

# EndOp