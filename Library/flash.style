QMainWindow {
	background: rgb(13, 14, 25);
}

QMainWindow::separator {
	width: 2px; 
	background: rgb(74, 82, 107);
}

/* Dock Widgets */

QDockWidget {
	color: rgb(74, 82, 107);
	background: rgb(13, 14, 25);
}

QPushButton {
	color: rgb(143, 144, 160);
	background-color: rgba(74, 82, 107, 63);
    height: 40;
    width: 40;
    qproperty-iconSize: 25px;
	border-radius: 4px;
}

QPushButton:hover:!pressed {
	color: rgb(143, 144, 160);
	background-color: rgba(74, 82, 107, 127);
}

QListWidget {
	color: rgba(255, 255, 255, 150);
	background-color: rgba(255, 255, 255, 10);
}

QListView {
	color: rgba(255, 255, 255, 150);
	background-color: rgba(255, 255, 255, 10);
}

QLabel {
	color: rgb(143, 144, 160);
}

QLineEdit {
	color: rgba(234, 235, 255, 180);
	background-color: rgb(69, 74, 92);
	border: none;
	selection-color: rgb(255, 255, 255);
	selection-background-color : rgb(64, 69, 102);
}

QTextEdit {
	background-color: rgba(255, 255, 255, 10);
}

/* Tabs */

QTabBar {                                          
	font-family: Helvetica;                          
	font-size: 8pt;                               
}

QTabWidget::pane { 
    border-top: 0px solid #191C1D;
	margin: -8px -8px -8px -8px;
}

QTabWidget::tab-bar {
    left: 0px;
}

QTabBar::tab {
	color: #FFFFFF;
    background: rgb(72, 69, 79);
    border: 1px solid #191C1D;
    border-bottom-color: #191C1D;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    min-width: 50px;
    min-height: 20px;
    padding: 2px;
	padding-left: 10px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: #49464F;
}

QTabBar::tab:selected {
	background: solid rgb(64, 69, 102);
    border-color: #191C1D;
    border-bottom-color: #191C1D;
}

QTabBar::tab:!selected {              
	color: rgb(74, 82, 107);             
	background: solid rgb(41, 43, 61);
}   

QScrollBar:vertical {
	background-color: rgb(8, 8, 10);
	width: 10px;
	border: none;
}

QScrollBar::handle:vertical {
	background-color: rgb(69, 74, 92);
	width: 10px;
	border-radius: 5px;
}

QScrollBar::add-line:vertical
{
	margin: 0px 3px 0px 3px;
	border-image: url(:/qss_icons/rc/right_arrow_disabled.png);
	width: 10px;
	height: 10px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical
{
	margin: 0px 3px 0px 3px;
	border-image: url(:/qss_icons/rc/left_arrow_disabled.png);
	height: 10px;
	width: 10px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical
{
	background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
	background: none;
}

QCheckBox {
	border: none;
}

QCheckBox::indicator::unchecked {
	background-color: rgb(234, 66, 74);
}

QCheckBox::indicator::checked {
	background-color: rgb(195, 232, 141);
}

QComboBox {
	border: none;
	color: rgb(143, 144, 160);
	background-color: rgb(8, 8, 10);
}

QComboBox::drop-down {
	border: none;
	color: rgb(143, 144, 160);
	background-color: rgb(8, 8, 10);
}

QComboBox::down-arrow {
	border: none;
	color: rgb(143, 144, 160);
	background-color: rgb(8, 8, 10);
}