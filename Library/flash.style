QGraphicsView {
        background-color: rgb(72, 69, 79);
}

QMainWindow {
	background: rgb(25, 28, 29);
}

QPushButton {
	color: rgba(255, 255, 255, 40);
	background-color: rgba(255, 255, 255, 20);
    height: 30;
    width: 30;
    qproperty-iconSize: 25px;
}

QPushButton:hover:!pressed {
	color: rgba(255, 255, 255, 80);
	background-color: rgba(255, 255, 255, 40)
}

QListWidget {
	color: rgba(255, 255, 255, 150);
	background-color: rgba(255, 255, 255, 10);
}

QLabel {
	color: rgba(255, 255, 255, 150);
}

QTextEdit {
	background-color: rgba(255, 255, 255, 10);
}

QMenuBar {
	color: rgba(255, 255, 255, 100);
	background-color: rgba(255, 255, 255, 0);
}

QTabWidget::pane {             
	border-width: 2px;         
	border-radius: 1px;        
}                              

QTabWidget::tab-bar {          
	left: 1px;                 
} 

QTabBar {                                          
	font-family: Helvetica;                          
	font-size: 10pt;                               
}

QTabBar::tab {                  
	background: rgb(72, 69, 79);                         
	color: rgb(255, 255, 255);        
	min-height: 20px;                              
	min-width: 40px;                              
	padding: 2px;                                  
}

QTabBar::tab:selected {                            
	border-color: #0000ff;                             
	border-bottom-color: #00ffffff;                
}

QTabBar::tab:!selected {                           
	margin-top: 2px;                               
}   