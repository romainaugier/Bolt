QMainWindow {
	background: #0F111A;
}

QPushButton {
	color: rgba(255, 255, 255, 40);
	background-color: rgba(255, 255, 255, 20);
    height: 30;
    width: 30;
    qproperty-iconSize: 25px;
}

QPushButton:hover:!pressed {
	color: rgba(255, 255, 255, 80);
	background-color: rgba(255, 255, 255, 40)
}

QListWidget {
	color: rgba(255, 255, 255, 150);
	background-color: rgba(255, 255, 255, 10);
}

QLabel {
	color: rgb(143, 144, 160);
}

QLineEdit {
	color: rgba(234, 235, 255, 180);
	background-color: rgb(69, 74, 92);
	border: none;
	selection-color: rgb(255, 255, 255);
	selection-background-color : rgb(64, 69, 102);
}

QTextEdit {
	background-color: rgba(255, 255, 255, 10);
}

/* Menus */

QMenuBar {
	color: rgba(255, 255, 255, 100);
	background-color: rgba(255, 255, 255, 0);
}

QMenu {
	background-color: rgb(255, 0, 0);
}

/* Tabs */

QTabBar {                                          
	font-family: Helvetica;                          
	font-size: 10pt;                               
}

QTabWidget::pane { 
    border-top: 0px solid #191C1D;
	margin: -8px -8px -8px -8px;
}

QTabWidget::tab-bar {
    left: 0px;
}

QTabBar::tab {
	color: #FFFFFF;
    background: rgb(72, 69, 79);
    border: 1px solid #191C1D;
    border-bottom-color: #191C1D; /* same as the pane color */
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    min-width: 50px;
    min-height: 20px;
    padding: 2px;
	padding-left: 10px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: #49464F;
}

QTabBar::tab:selected {
    border-color: #191C1D;
    border-bottom-color: #191C1D;
	border-top-color: #FABD00;
	border-top-width: 2px;
}

QTabBar::tab:!selected {                           
	background: solid rgb(72, 69, 79);
}   