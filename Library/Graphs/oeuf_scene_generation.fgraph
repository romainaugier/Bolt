      "iconPath": "$FLASH_ICONS/guerilla-render.png",
      "definitionPath": "C:/Users/augie/Documents/Flash/Library/Nodes/guerilla_load_alembics.fnode",
      "nodeType": "Guerilla/Guerilla_LoadAlembics",
      "opCode": "# BeginOp\n\nif type(inabcfiles) is str:\n    inabcfiles = [inabcfiles]\n\ngeneratedScript = f\"\"\"import guerilla, os\n\npaths = {inabcfiles}\n\nfor path in paths:\n    name = os.path.basename(path)\n\n    with guerilla.Modifier() as mod:\n        mod.createref(name, path, options={{ 'prefixnodes' : False,'containschildren' : True }})\n\nguerilla.Document().save()\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\noutscripttext = generatedScript\n\n",
