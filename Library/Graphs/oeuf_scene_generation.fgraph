    {
      "name": "Guerilla_GuerillaBatch",
      "category": "Guerilla",
      "id": "3637643661656438393737323935323632346461616532303237376136376564",
      "color": [
        52,
        115,
        165
      ],
      "iconPath": "$FLASH_ICONS/guerilla-render.png",
      "definitionPath": "C:/Users/augie/Documents/Flash/Library/Nodes/guerilla_guerillabatch.fnode",
      "nodeType": "Guerilla/Guerilla_GuerillaBatch",
      "opCode": "# BeginOp\n\nimport subprocess, platform, os\n\nFlashLogMessage(f\"GuerillaBatch : Start executing script : {inscript}\")\n\nif platform.system == \"windows\":\n    command = [f\"{inenvironment['GUERILLA']}/guerillaBatch\", \"--nogui\"] \n    \n    if os.path.exists(inguerillafile):\n        command.append(inguerillafile)\n    \n    command.append(inscript)\nelse:\n    command = [f\"{inenvironment['GUERILLA']}/guerilla\", \"--nogui\"]\n\n    if os.path.exists(inguerillafile):\n        command.append(inguerillafile)\n    \n    command.append(inscript)\n\nFlashLogMessage(f\"GuerillaBatch Command : {' '.join(command)}\")\n\nenv = os.environ.copy()\nenv.update(inenvironment)\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env)\n\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    FlashLogError(stderrAsStr)\nelse:\n    FlashLogMessage(f\"GuerillaBatch : Finished executing script : {inscript}\")\n    FlashLogMessage(stdoutAsStr)\n\n",
      "disabled": false,
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
