    {
      "name": "Hou_Hython",
      "category": "Houdini",
      "id": "3664333434616330613532313764636164306236653365363861306262363533",
      "color": [
        255,
        87,
        34
      ],
      "iconPath": "$FLASH_ICONS/houdini.png",
      "definitionPath": "C:/Users/augie/Documents/Flash/Library/Nodes/hou_hython.fnode",
      "nodeType": "Houdini/Hou_Hython",
      "opCode": "# BeginOp\n\nimport subprocess, os\n\nFlashLogMessage(f\"Hython : Start executing script : {inscript}\")\n\ncommand = [\"hython\"]\n\nif os.path.exists(inhoufile):\n    command.append(inhoufile)\n\ncommand.append(inscript)\n\nFlashLogMessage(f\"Hython Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    FlashLogError(stderrAsStr)\nelse:\n    FlashLogMessage(f\"Hython : Finished executing script : {inscript}\")\n    FlashLogMessage(stdoutAsStr)\n\n\n\n",
      "disabled": false,
      "isIfBegin": false,
