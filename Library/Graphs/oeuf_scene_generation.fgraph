      "iconPath": "$FLASH_ICONS/guerilla-render.png",
      "definitionPath": "C:/Users/augie/Documents/Flash/Library/Nodes/guerilla_create_scene.fnode",
      "nodeType": "Guerilla/Guerilla_CreateScene",
      "opCode": "# BeginOp\n\n# BeginOp\n\n# BeginOp\n\n# BeginOp\n\nimport os\n\nif os.path.exists(infilepath):\n    os.remove(infilepath)\n\ndir = os.path.dirname(infilepath)\n\nif not os.path.exists(dir):\n    os.makedirs(dir)\n\ngeneratedScript = f\"\"\"import guerilla\n\nimport RomanoTools.Guerilla.Utils as utils\n\nutils.SetOptims()\nutils.SetRange(\"{inframerange[0]}-{inframerange[1]}\")\n\nrenderPass = guerilla.Document().findchild(\"RenderPass\")\n\nrenderPass.FileLayerName.set(\"$o_$n\")\n\nguerilla.Document().ProjectWidth.set(2048)\nguerilla.Document().ProjectHeight.set(858)\n\nlayer = guerilla.Document().findchild(\"RenderPass|Layer\")\n\naovNames = {inrenderpasses}\n\naovsToAdd = {inrenderpasses}\n\nexistingAovs = [aov.PlugName.get() for aov in layer.children()]\n\nfor aov in aovNames:\n\tif aov in existingAovs:\n\t\taovsToAdd.remove(aov)\n\nwith guerilla.Modifier() as mod:\n\tfor aov in aovsToAdd:\n\t\tlayer.addaov(aov)\n\nguerilla.Document().save(\"{infilepath}\")\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\noutscripttext = generatedScript\n\n\n\n\n",
