      "opCode": "# BeginOp\n\nimport os\n\nfr = inshotspecs[\"FrameRange\"].split(\"-\")\nframerange = [int(fr[0]), int(fr[1])]\n\ncacheDir = f\"{incachedir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/Corinne\"\noutputfilefur = f\"{cacheDir}/{inshotspecs['Sequence']}_{inshotspecs['Shot']}_corinne_cache_fur.abc\"\noutputfileplumes = f\"{cacheDir}/{inshotspecs['Sequence']}_{inshotspecs['Shot']}_corinne_cache_plumes.abc\"\n\ngeneratedScript = f\"\"\"import hou\nanimSopNode = None\nplumeSopNode = None\n\nfor node in hou.node(\"/obj\").children():\n    if node.name() == \"anim_import\":\n        animSopNode = node\n    elif node.name() == \"EXPORT\":\n        plumeSopNode = node\n\nif animSopNode != None:\n    for node in animSopNode.children():\n        if node.type().name() == \"alembic\":\n            node.parm(\"fileName\").set(\"{inanimationfile}\")\n            break\n\nif plumeSopNode != None:\n    for node in plumeSopNode.children():\n        if node.name() == \"rop_alembic_fur\":\n            node.parm(\"filename\").set(\"{outputfilefur}\")\n            node.parm(\"f1\").set({framerange[0]})\n            node.parm(\"f2\").set({framerange[1]})\n            node.parm(\"execute\").pressButton()\n        if node.name() == \"rop_alembic_plumes\":\n            node.parm(\"filename\").set(\"{outputfileplumes}\")\n            node.parm(\"f1\").set({framerange[0]})\n            node.parm(\"f2\").set({framerange[1]})\n            node.parm(\"execute\").pressButton()\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\noutabccachefile = [outputfilefur, outputfileplumes]\n\n",
