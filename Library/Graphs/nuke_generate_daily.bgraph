    {
      "name": "NK_GenerateDaily1",
      "category": "Nuke",
      "id": "3738396565336231356266653933336633376436343864313235653237383830",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/nuke.png",
      "definitionPath": "$BOLT_LIB/Nodes/nk_generatedaily.bnode",
      "nodeType": "Nuke/NK_GenerateDaily",
      "opCode": "\nif inapplyaces:\n    writeNodeName = \"MAIN_WRITE\"\nelse:\n    writeNodeName = \"MAIN_WRITE_RAW\"\n\ngeneratedScript = f\"\"\"import nuke, os, sys\n\nnuke.scriptOpen(\"{innuketemplate}\")\n\nseqs = nuke.getFileNameList(\"{inrenderdir}\")\n\nsupdir = os.path.basename(\"{inrenderdir}\")\nsupdir1 = os.path.basename(os.path.dirname(\"{inrenderdir}\"))\nsupdir2 = os.path.basename(os.path.dirname(os.path.dirname(\"{inrenderdir}\")))\n\noutputfile = \"{inrenderdir}/daily/{{}}_{{}}_{{}}_daily.mov\".format(supdir2, supdir1, supdir)\n\nprint(seqs)\n\nif len(seqs) > 0:\n    if not os.path.exists(outputfile):\n        os.makedirs(os.path.dirname(outputfile))\n\n    read = nuke.toNode(\"MAIN_READ\")\n    read.knob(\"file\").fromUserText(\"{inrenderdir}/\" + seqs[0])\n\n    write = nuke.toNode(\"{writeNodeName}\")\n    write.knob(\"file\").fromUserText(outputfile)\n\n    first = int(read.knob(\"first\").getValue())\n    last = int(read.knob(\"last\").getValue())\n\n    nuke.execute(\"{writeNodeName}\", start=first, end=last, incr=1)\n\nelse:\n    sys.stderr.write(\"[ERROR] Nk_GenerateDaily : No file sequence found\")\n\n\"\"\"\n\ntmpScriptFilePath = BoltTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as file:\n    file.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\n\n",
      "disabled": false,
      "isSubGraph": false,
