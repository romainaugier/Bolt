    "opCode": "# BeginOp\n\nimport subprocess\n\nBoltLogMessage(f\"Hython : Start executing script : {input0}\")\n\nprocess = subprocess.Popen([\"hython\", input0], stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    BoltLogError(stderrAsStr)\nelse:\n    BoltLogMessage(f\"Hython : Finished executing script : {input0}\")\n    BoltLogMessage(stdoutAsStr)\n\n",
