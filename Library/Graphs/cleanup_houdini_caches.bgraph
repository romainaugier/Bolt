      ],
      "iconPath": "$BOLT_ICONS/util.png",
      "definitionPath": "$BOLT_LIB/Nodes/Hou_CleanupCaches.bnode",
      "nodeType": "Utility/Hou_CleanupCaches",
      "opCode": "\nimport os\n\ncacheFilesRemoved = 0\nbackupFilesRemoved = 0\n\nfor root, dirs, files in os.walk(indirectory):\n    for file in files:\n        filename, ext = os.path.splitext(file)\n\n        filepath = os.path.join(root, file)\n        filepath = filepath.replace(\"/\", \"\\\\\")\n\n        # Caches\n        if \"vdb\" in ext or \"bgeo.sc\" in file:\n            os.remove(filepath)\n\n            cacheFilesRemoved += 1\n\n        # Backup\n        if \"bak\" in filename and \"hipnc\" in ext and \"backup\" in filepath:\n            os.remove(filepath)\n            \n            backupFilesRemoved += 1\n\nBoltLogMessage(f\"Removed {cacheFilesRemoved} cache files\")\nBoltLogMessage(f\"Removed {backupFilesRemoved} backup files\")\n",
      "disabled": false,
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
      "inputs": {
        "indirectory": [
