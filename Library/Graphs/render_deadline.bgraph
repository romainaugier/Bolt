    {
      "name": "Deadline_SubmitGuerillaJob1",
      "category": "Deadline",
      "id": "3833383766363136663338353232646164333534633830623733663936323464",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/deadline.png",
      "definitionPath": "$BOLT_LIB/Nodes/deadline_submit_guerilla_job.bnode",
      "nodeType": "Deadline/Deadline_SubmitGuerillaJob",
      "opCode": "\nimport subprocess, re\n\njobRibgenName = \"\"\njobRenderName = \"\"\n\nwith open(inribgenjobinfo, \"r\") as file:\n    for line in file.readlines():\n        if line.startswith(\"Name\"):\n            jobRibgenName = line.split(\"=\")[1]\n\nwith open(inrenderjobinfo, \"r\") as file:\n    for line in file.readlines():\n        if line.startswith(\"Name\"):\n            jobRenderName = line.split(\"=\")[1]\n\nBoltLogMessage(f\"Deadline : Submitting ribgen job {jobRibgenName}\")\nBoltLogMessage(f\"Deadline : Submitting render job {jobRenderName}\")\n\ncommand = [\n    \"deadlinecommand\",\n    \"-Multi\",\n    \"-job\",\n    inribgenjobinfo,\n    inribgenplugininfo,\n    \"-job\",\n    \"-dependsOnPrevious\",\n    inrenderjobinfo,\n    inrenderplugininfo\n]\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    BoltLogError(stderrAsStr)\nelse:\n    jobIdPattern = r\"JobID=(\\S+)\"\n\n    matches = re.findall(jobIdPattern, stdoutAsStr)\n\n    outribgenjobid = matches[0]\n    outrenderjobid = matches[1]\n\n    BoltLogMessage(f\"Deadline : Finished submitting job. \\n    Ribgen Job ID = {outribgenjobid}\\n    Render Job ID = {outrenderjobid}\")\n\n    BoltLogMessage(stdoutAsStr)\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
        "inribgenjobinfo": [
