    {
      "name": "Guerilla_PrepareDeadlineJob",
      "category": "Guerilla",
      "id": "3534396663623431333835383834373461636530363139306432346462303061",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/guerilla-render.png",
      "definitionPath": "$BOLT_LIB/Nodes/guerilla_prepare_deadline_job.bnode",
      "nodeType": "Guerilla/Guerilla_PrepareDeadlineJob",
      "opCode": "\n# BeginOp\n\n# BeginOp\n\n# BeginOp\n\nfrom datetime import datetime\nimport re, os, subprocess, platform\n\nnow = datetime.now()\n\ncurrentTimeStr = now.strftime('%m%d%Y_%H%M%S')\n\n# Setup job and batch name\nteamName = inrenderoptions[\"Team\"]\njobType = inrenderoptions[\"Type\"]\nsequenceName = inrenderoptions[\"SequenceName\"] \nshotName = inrenderoptions[\"ShotName\"]\nframeRange = inrenderoptions[\"FrameRange\"]\n\njobName = f\"{teamName}_{jobType}_{sequenceName}_{shotName}\"\nbatchName = f\"{jobName}-{currentTimeStr}\"\n\nif jobType == \"LD\":\n    injoboptions[\"Priority\"] = 50\nelif jobType == \"FML\":\n    injoboptions[\"Priority\"] = 75\nelif jobType == \"HD\":\n    injoboptions[\"Priority\"] = 25\n\nrenderDir = f\"{inrenderdir}/{sequenceName}/{shotName}/{jobType}1\"\n\nwhile os.path.exists(renderDir):   \n    numPattern = r\"(\\d+)$\"\n\n    match = re.search(numPattern, renderDir)\n\n    value = int(match.group()) + 1\n\n    renderDir = f\"{renderDir[:match.start()]}{value}\"\n\nos.makedirs(renderDir)\nBoltLogMessage(f\"RenderDir : {renderDir}\")\n\nrenderFile = f\"{renderDir}/render_{sequenceName}_{shotName}_$f.$x\"\nopenExrIdFile = f\"{renderDir}/render_{sequenceName}_{shotName}_id_$f.$x\"\n\n# Setup job options\ninjoboptions[\"Plugin\"] = \"Guerilla\"\ninjoboptions[\"Name\"] = jobName\ninjoboptions[\"BatchName\"] = batchName\ninjoboptions[\"Frames\"] = frameRange\ninjoboptions[\"OutputDirectory0\"] = renderDir\n\n# Render Job Infos\ngeneratedRenderJobInfos = \"\"\n\nfor key, item in injoboptions.items():\n    generatedRenderJobInfos += f\"{key}={item}\\n\"\n\n# Ribgen Job Infos\ninjoboptions[\"Name\"] = f\"{jobName}_ribgen\"\ninjoboptions[\"Frames\"] = 0\n\ngeneratedRibgenJobInfos = \"\"\n\nfor key, item in injoboptions.items():\n    generatedRibgenJobInfos += f\"{key}={item}\\n\"\n\n# Generate Guerilla script\n\ngeneratedScript = f\"\"\"import guerilla, os\nimport RomanoTools.Guerilla.Utils as utils\n\nlayer = guerilla.Document().findchild(\"RenderPass|Layer\")\n\naovs = {inrenderpasses}\n\nexistingAovs = [aov.PlugName.get() for aov in layer.children()]\n\naovsToAdd = {inrenderpasses}\n\nfor aov in aovs:\n    if aov in existingAovs:\n        aovsToAdd.remove(aov)\n\nwith guerilla.Modifier() as mod:\n\n    for aov in layer.children():\n        if aov.PlugName.get() == \"Albedo\":\n            aov.OverrideSettings.set(True)\n            aov.DisplayDriver.set(\"exrid\")\n            aov.FileName.set(\"{openExrIdFile}\")\n\n    utils.SetRange(\"{frameRange}\")\n    utils.SetOptims()\n\n    if \"{jobType}\" == \"LD\":\n        utils.SetLowRenderParms()\n    else:\n        utils.SetFinalRenderParms()\n\n    prefNode = guerilla.Document().findchild(\"Preferences\")\n\n    prefNode.RenderfarmSequence.set(\"{jobName}\")\n    prefNode.DeferredRibGen.set(True)\n\n    renderPass = guerilla.Document().findchild(\"RenderPass\")\n    renderPass.FileName.set(\"{renderFile}\")\n    renderPass.DisplayDriver.set(\"exr\")\n\nsceneDir = guerilla.envcontext.getenv(\"SCENE_PATH\")\njobsDir = \"{{}}/jobs\".format(sceneDir)\n\noptions = guerilla.renderoptions({{}})\n\noptions[\"JobsDirectory\"] = jobsDir\noptions[\"DeferredRibGenBatch\"] = 0\noptions[\"DeferredFile\"] = \"{{}}/{{}}_ribgen_{{}}.gproject\".format(jobsDir, options[\"FilePrefix\"], options[\"RenderId\"])\n\nscriptFiles = guerilla.render(\"none\", options)\n\nribgenScriptFile = scriptFiles[0].getscriptfile(0)\nrenderScriptFile = scriptFiles[1].getscriptfile(0)\n\nprint(\"RIBGEN_SCRIPT_FILE={{}}\".format(\"{{}}/{{}}\".format(jobsDir, ribgenScriptFile)))\nprint(\"RENDER_SCRIPT_FILE={{}}\".format(\"{{}}/{{}}\".format(jobsDir, renderScriptFile)))\n\nguerilla.Document().save()\n\"\"\"\n\n# Start the guerilla scene and execute the script to prepare it\n\ntmpScriptFilePath = BoltTempScript()\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\nBoltLogMessage(f\"GuerillaBatch : Start executing script : {tmpScriptFilePath}\")\n\nif platform.system == \"windows\":\n    command = [f\"{inenvironment['GUERILLA']}/guerillaBatch\", \"--nogui\"] \n    \n    if os.path.exists(inguerillafile):\n        command.append(inguerillafile)\n    \n    command.append(tmpScriptFilePath)\nelse:\n    command = [f\"{inenvironment['GUERILLA']}/guerilla\", \"--nogui\"]\n\n    if os.path.exists(inguerillafile):\n        command.append(inguerillafile)\n    \n    command.append(tmpScriptFilePath)\n\nBoltLogMessage(f\"GuerillaBatch Command : {' '.join(command)}\")\n\nenv = os.environ.copy()\nenv.update(inenvironment)\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env)\n\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    BoltLogError(stderrAsStr)\nelse:\n    BoltLogMessage(f\"GuerillaBatch : Finished executing script : {tmpScriptFilePath}\")\n    BoltLogMessage(stdoutAsStr)\n\n# Get the generated guerilla scriptfiles paths\n\nribgenScriptPattern = r\"RIBGEN_SCRIPT_FILE=(\\S+)\"\nrenderScriptPattern = r\"RENDER_SCRIPT_FILE=(\\S+)\"\n\nribGenScriptFilePath = re.findall(ribgenScriptPattern, stdoutAsStr)[0]\nrenderScriptFilePath = re.findall(renderScriptPattern, stdoutAsStr)[0]\n\ntmpDirPath = BoltTempDir()\n\n# Render Job Infos\nrenderJobInfoFile = f\"{tmpDirPath}/render_job_info_{currentTimeStr}.job\"\n\nwith open(renderJobInfoFile, \"w\") as file:\n    file.write(generatedRenderJobInfos) \n\n# Render Plugin Infos\nrenderJobPluginFile = f\"{tmpDirPath}/render_plugin_info_{currentTimeStr}.job\"\n\nwith open(renderJobPluginFile, \"w\") as file:\n    file.write(f\"ScriptFile={renderScriptFilePath}\\nScriptArgs=\\\"--frame={frameRange.split('-')[0]}\\\"\")\n\n# Ribgen Job Infos\nribgenJobInfoFile = f\"{tmpDirPath}/ribgen_job_info_{currentTimeStr}.job\"\n\nwith open(ribgenJobInfoFile, \"w\") as file:\n    file.write(generatedRibgenJobInfos)\n\n# Ribgen Plugin Infos\nribgenJobPluginFile = f\"{tmpDirPath}/ribgen_plugin_info_{currentTimeStr}.job\"\n\nwith open(ribgenJobPluginFile, \"w\") as file:\n    file.write(f\"ScriptFile={ribGenScriptFilePath}\\nScriptArgs=\")\n\noutribgenjobinfofile = ribgenJobInfoFile\noutribgenplugininfofile = ribgenJobPluginFile\noutrenderjobinfofile = renderJobInfoFile\noutrenderplugininfofile = renderJobPluginFile\noutrenderdir = renderDir\n\n\n\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
