      "subgraph": "{\n  \"nodes\": [\n    {\n      \"name\": \"Inputs\",\n      \"category\": \"Utility\",\n      \"id\": \"3239346264643534306266663538656635663134386531343030393930303061\",\n      \"color\": [\n        137,\n        221,\n        255\n      ],\n      \"iconPath\": \"$BOLT_ICONS/inputs.png\",\n      \"definitionPath\": \"\",\n      \"nodeType\": \"Inputs\",\n      \"opCode\": \"\",\n      \"disabled\": false,\n      \"isSubGraph\": false,\n      \"inputs\": {},\n      \"outputs\": {\n        \"input0\": [\n          {\n            \"shortName\": \"input0\",\n            \"longName\": \"Input0\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": null,\n            \"defaultData\": null,\n            \"type\": 11,\n            \"connectionName\": \"inrenderdir\",\n            \"connectionNodeId\": \"6166656539633430343066313436393466376437613766373737333838626266\"\n          }\n        ],\n        \"incondition\": [\n          {\n            \"shortName\": \"incondition\",\n            \"longName\": \"Condition\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": null,\n            \"defaultData\": null,\n            \"type\": 8,\n            \"connectionName\": null,\n            \"connectionNodeId\": null\n          }\n        ]\n      }\n    },\n    {\n      \"name\": \"Outputs\",\n      \"category\": \"Utility\",\n      \"id\": \"3862383339306265643532373565326633613034303265623639313066643830\",\n      \"color\": [\n        137,\n        221,\n        255\n      ],\n      \"iconPath\": \"$BOLT_ICONS/outputs.png\",\n      \"definitionPath\": \"\",\n      \"nodeType\": \"Outputs\",\n      \"opCode\": \"\",\n      \"disabled\": false,\n      \"isSubGraph\": false,\n      \"inputs\": {\n        \"output0\": [\n          {\n            \"shortName\": \"output0\",\n            \"longName\": \"Output0\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": null,\n            \"defaultData\": null,\n            \"type\": 11,\n            \"connectionName\": \"outfile\",\n            \"connectionNodeId\": \"3562663738323364663932636537663963363566323633303130663062323931\"\n          }\n        ]\n      },\n      \"outputs\": {}\n    },\n    {\n      \"name\": \"NK_GenerateDaily\",\n      \"category\": \"Nuke\",\n      \"id\": \"6166656539633430343066313436393466376437613766373737333838626266\",\n      \"color\": [\n        0,\n        0,\n        0\n      ],\n      \"iconPath\": \"$BOLT_ICONS/nuke.png\",\n      \"definitionPath\": \"$BOLT_LIB/Nodes/nk_generatedaily.bnode\",\n      \"nodeType\": \"Nuke/NK_GenerateDaily\",\n      \"opCode\": \"\\nif inapplyaces:\\n    writeNodeName = \\\"MAIN_WRITE\\\"\\nelse:\\n    writeNodeName = \\\"MAIN_WRITE_RAW\\\"\\n\\ngeneratedScript = f\\\"\\\"\\\"import nuke, os, sys\\n\\nnuke.scriptOpen(\\\"{innuketemplate}\\\")\\n\\nseqs = nuke.getFileNameList(\\\"{inrenderdir}\\\")\\n\\nsupdir = os.path.basename(\\\"{inrenderdir}\\\")\\nsupdir1 = os.path.basename(os.path.dirname(\\\"{inrenderdir}\\\"))\\nsupdir2 = os.path.basename(os.path.dirname(os.path.dirname(\\\"{inrenderdir}\\\")))\\n\\noutputfile = \\\"{inrenderdir}/daily/{{}}_{{}}_{{}}_daily.mov\\\".format(supdir2, supdir1, supdir)\\n\\nprint(seqs)\\n\\nif len(seqs) > 0:\\n    if not os.path.exists(outputfile):\\n        os.makedirs(os.path.dirname(outputfile))\\n\\n    read = nuke.toNode(\\\"MAIN_READ\\\")\\n    read.knob(\\\"file\\\").fromUserText(\\\"{inrenderdir}/\\\" + seqs[0])\\n\\n    write = nuke.toNode(\\\"{writeNodeName}\\\")\\n    write.knob(\\\"file\\\").fromUserText(outputfile)\\n\\n    first = int(read.knob(\\\"first\\\").getValue())\\n    last = int(read.knob(\\\"last\\\").getValue())\\n\\n    nuke.execute(\\\"{writeNodeName}\\\", start=first, end=last, incr=1)\\n\\nelse:\\n    sys.stderr.write(\\\"[ERROR] Nk_GenerateDaily : No file sequence found\\\")\\n\\n\\\"\\\"\\\"\\n\\ntmpScriptFilePath = BoltTempScript()\\n\\nwith open(tmpScriptFilePath, \\\"w\\\") as file:\\n    file.write(generatedScript)\\n\\noutscriptfile = tmpScriptFilePath\\n\\n\",\n      \"disabled\": false,\n      \"isSubGraph\": false,\n      \"inputs\": {\n        \"inrenderdir\": [\n          {\n            \"shortName\": \"inrenderdir\",\n            \"longName\": \"Render Directory\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"\",\n            \"defaultData\": \"\",\n            \"type\": 7,\n            \"connectionName\": \"input0\",\n            \"connectionNodeId\": \"3239346264643534306266663538656635663134386531343030393930303061\"\n          }\n        ],\n        \"inapplyaces\": [\n          {\n            \"shortName\": \"inapplyaces\",\n            \"longName\": \"Apply ACES Correction\",\n            \"index\": 0,\n            \"isExposed\": true,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": true,\n            \"defaultData\": true,\n            \"type\": 8,\n            \"connectionName\": null,\n            \"connectionNodeId\": null\n          }\n        ],\n        \"innuketemplate\": [\n          {\n            \"shortName\": \"innuketemplate\",\n            \"longName\": \"Nuke Template File\",\n            \"index\": 0,\n            \"isExposed\": true,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"D:/dev/Bolt/Library/Templates/Nuke/generate_daily.nk\",\n            \"defaultData\": \"D:/dev/Bolt/Library/Templates/Nuke/generate_daily.nk\",\n            \"type\": 7,\n            \"connectionName\": null,\n            \"connectionNodeId\": null\n          }\n        ]\n      },\n      \"outputs\": {\n        \"outscriptfile\": [\n          {\n            \"shortName\": \"outscriptfile\",\n            \"longName\": \"Script File\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"\",\n            \"defaultData\": \"\",\n            \"type\": 7,\n            \"connectionName\": \"inscriptfile\",\n            \"connectionNodeId\": \"3562663738323364663932636537663963363566323633303130663062323931\"\n          }\n        ],\n        \"outrenderdir\": [\n          {\n            \"shortName\": \"outrenderdir\",\n            \"longName\": \"Render Directory\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"\",\n            \"defaultData\": \"\",\n            \"type\": 7,\n            \"connectionName\": null,\n            \"connectionNodeId\": null\n          }\n        ]\n      }\n    },\n    {\n      \"name\": \"NK_NukePy\",\n      \"category\": \"Nuke\",\n      \"id\": \"3562663738323364663932636537663963363566323633303130663062323931\",\n      \"color\": [\n        0,\n        0,\n        0\n      ],\n      \"iconPath\": \"$BOLT_ICONS/nuke.png\",\n      \"definitionPath\": \"$BOLT_LIB/Nodes/nk_nukepy.bnode\",\n      \"nodeType\": \"Nuke/NK_NukePy\",\n      \"opCode\": \"\\n# BeginOp\\n\\nimport subprocess, os\\n\\nBoltLogMessage(f\\\"NukeBatch : Start executing script : {inscriptfile}\\\")\\n\\ncommand = [f\\\"{innukebindir}\\\", \\\"-t\\\", inscriptfile]\\n\\nfor arg in inargs:\\n    command.append(arg)\\n\\nBoltLogMessage(f\\\"NukeBatch Command : {' '.join(command)}\\\")\\n\\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, encoding=\\\"ISO-8859-1\\\")\\n\\nstdout = []\\n\\nwhile True:\\n    output = process.stdout.readline()\\n\\n    if process.poll() is not None:\\n        break\\n    if output:\\n        stdout.append(output)\\n        print(output.strip())\\n\\nfor line in stdout:\\n    if line.startswith(\\\"OUTPUTFILE\\\"):\\n        outfile = line.split(\\\"=\\\")[1].strip()\\n\\nBoltLogMessage(f\\\"NukeBatch : Finished executing script\\\")\\n\\n\",\n      \"disabled\": false,\n      \"isSubGraph\": false,\n      \"inputs\": {\n        \"inscriptfile\": [\n          {\n            \"shortName\": \"inscriptfile\",\n            \"longName\": \"Script File\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"\",\n            \"defaultData\": \"\",\n            \"type\": 7,\n            \"connectionName\": \"outscriptfile\",\n            \"connectionNodeId\": \"6166656539633430343066313436393466376437613766373737333838626266\"\n          }\n        ],\n        \"inargs\": [\n          {\n            \"shortName\": \"inargs\",\n            \"longName\": \"Script Arguments\",\n            \"index\": 0,\n            \"isExposed\": true,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": [],\n            \"defaultData\": [],\n            \"type\": 9,\n            \"connectionName\": null,\n            \"connectionNodeId\": null\n          }\n        ],\n        \"innukebindir\": [\n          {\n            \"shortName\": \"innukebindir\",\n            \"longName\": \"Nuke Binary Directory\",\n            \"index\": 0,\n            \"isExposed\": true,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"C:/Program Files/Nuke13.0v5/Nuke13.0.exe\",\n            \"defaultData\": \"C:/Program Files/Nuke13.0v5/Nuke13.0.exe\",\n            \"type\": 7,\n            \"connectionName\": null,\n            \"connectionNodeId\": null\n          }\n        ]\n      },\n      \"outputs\": {\n        \"outfile\": [\n          {\n            \"shortName\": \"outfile\",\n            \"longName\": \"Output File\",\n            \"index\": 0,\n            \"isExposed\": false,\n            \"isHidden\": false,\n            \"isExposedToGraph\": false,\n            \"data\": \"\",\n            \"defaultData\": \"\",\n            \"type\": 7,\n            \"connectionName\": \"output0\",\n            \"connectionNodeId\": \"3862383339306265643532373565326633613034303265623639313066643830\"\n          }\n        ]\n      }\n    }\n  ],\n  \"tracker\": null\n}",
      "isIfBlock": true
    },
