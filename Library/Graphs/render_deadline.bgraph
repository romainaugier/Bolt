    {
      "name": "Deadline_WaitForJobFinished",
      "category": "Deadline",
      "id": "3934303435383636343131383961653666623734393730623333653536663535",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/deadline.png",
      "definitionPath": "$BOLT_LIB/Nodes/deadline_wait_for_job.bnode",
      "nodeType": "Deadline/Deadline_WaitForJobFinished",
      "opCode": "\nimport subprocess, time\n\nBoltLogMessage(f\"Deadline : Waiting for job {injobid}\")\n\njobIsNotComplete = True\n\nwhile jobIsNotComplete:\n\n    process = subprocess.Popen([\"deadlinecommand\", \"-GetJob\", injobid], stdout = subprocess.PIPE, stderr = subprocess.PIPE)\n    stdout, stderr = process.communicate()\n\n    stdoutAsStr = stdout.decode(\"utf-8\")\n    stderrAsStr = stderr.decode(\"utf-8\")\n\n    for line in stdoutAsStr.splitlines():\n        if line.startswith(\"JobStatus\"):\n            jobStatus = line.split(\"=\")[1]\n\n            if jobStatus == \"Completed\":\n                jobIsNotComplete = False\n                outjobcomplete = True\n                BoltLogMessage(f\"Deadline : Job {injobid} is complete\")\n                break\n            elif jobStatus == \"Failed\":\n                jobIsNotComplete = False\n                outjobcomplete = False\n                BoltLogWarning(f\"Deadline : Job {injobid} is failed\")\n                break\n            else:\n                time.sleep(60)\n                break\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
        "injobid": [
          {
            "shortName": "injobid",
            "longName": "Job ID",
            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": "",
            "defaultData": "",
            "type": 7,
            "connectionName": "outrenderjobid",
            "connectionNodeId": "3833383766363136663338353232646164333534633830623733663936323464"
          }
        ]
      },
      "outputs": {
        "outjobcomplete": [
          {
            "shortName": "outjobcomplete",
            "longName": "Job Complete",
            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": true,
            "defaultData": true,
