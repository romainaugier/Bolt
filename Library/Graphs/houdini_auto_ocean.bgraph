    {
      "name": "Hou_Hython",
      "category": "Houdini",
      "id": "6630386237333535386166323662303730393235366138346666376466656432",
      "color": [
        255,
        87,
        34
      ],
      "iconPath": "$BOLT_ICONS/houdini.png",
      "definitionPath": "$BOLT_LIB/Nodes/hou_hython.bnode",
      "nodeType": "Houdini/Hou_Hython",
      "opCode": "\nimport subprocess, os, sys\n\nBoltLogMessage(f\"Hython : Start executing script : {inscript}\")\n\ncommand = [\"hython\"]\n\nif os.path.exists(inhoufile):\n    command.append(inhoufile)\n\ncommand.append(inscript)\n\nBoltLogMessage(f\"Hython Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, encoding=\"utf-8\")\n\nwhile process.poll() is None:\n    output = process.stdout.readline()\n    errput = process.stderr.readline()\n\n    if len(errput) > 0:\n        BoltLogError(errput)\n        BoltLogError(f\"Hython error, terminating subprocess. Check the log for more details\")\n        sys.stderr.flush()\n        process.terminate()\n        break\n    elif output:\n        print(output.strip(), flush=True)\n\nBoltLogMessage(f\"Hython : Finished executing script : {inscript}\")\n\n",
      "disabled": false,
      "isSubGraph": false,
      "inputs": {
        "inscript": [
          {
            "shortName": "inscript",
            "longName": "Input Script Path",
            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": "C:\\Users\\r.augier\\AppData\\Roaming\\Bolt/6134373033646639343066653465343236323561383061663037306664336630.py",
