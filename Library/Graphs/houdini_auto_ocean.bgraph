    {
      "name": "Hou_AutoOcean1",
      "category": "Houdini",
      "id": "3930333666316136653265666263323562653735346662376139636662623530",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/houdini.png",
      "definitionPath": "$BOLT_LIB/Nodes/hou_autoocean.bnode",
      "nodeType": "Houdini/Hou_AutoOcean",
      "opCode": "\nimport os\n\nframerange = inshotspecs[\"FrameRange\"].split(\"-\")\n\noutputfilename = f\"{inshotspecs['Sequence'].lower()}_{inshotspecs['Shot'].lower()}_water_plane\"\noutputabcfile = f\"{infxdir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/ocean/export/abc/{outputfilename}.abc\"\noutputhoufile = f\"{infxdir}/{inshotspecs['Sequence']}/{inshotspecs['Shot']}/ocean/{outputfilename}.hipnc\"\n\nif not os.path.exists(os.path.dirname(outputhoufile)):\n    os.makedirs(os.path.dirname(outputhoufile))\n\nBoltLogMessage(f\"Output file : {outputhoufile}\")\n\ngeneratedScript = f\"\"\"import hou\n\nabcCamNode = None\nwaterNode = None\n\nfor node in hou.node(\"/obj\").children():\n    if node.name() == \"CAM\":\n        abcCamNode = node\n    elif node.name() == \"WATER\":\n        waterNode = node\n\nif abcCamNode != None:\n    abcCamNode.parm(\"fileName\").set(\"{incameraabcfile}\")\n    abcCamNode.parm(\"buildHierarchy\").pressButton()\n\n    print(\"Input Camera : {{}}\".format(\"{incameraabcfile}\"))\n\ncamera = hou.nodeType(hou.objNodeTypeCategory(),\"cam\").instances()[0]\n\nif waterNode != None:\n    for node in waterNode.children():\n        if node.type().name() == \"alembic\":\n            node.parm(\"fileName\").set(\"{inplanefile}\")\n\n    for node in waterNode.children():\n        if node.type().name() == \"rop_alembic\":\n            node.parm(\"filename\").set(\"{outputabcfile}\")\n            node.parm(\"f1\").set({framerange[0]})\n            node.parm(\"f2\").set({framerange[1]})\n\nhou.hipFile.save(file_name=\"{outputhoufile}\")\n\"\"\"\n\ntmpScriptFilePath = BoltTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\n\n",
      "disabled": false,
      "isSubGraph": false,
