            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": "import guerilla, os\n\n\n# Script 1\n\npaths = ['Z:/OEUF/BORDEL/TESTPLUMES/RumbaDance_Bird.abc', 'Z:/OEUF/CACHE/tests/zumba_dance/Charles/tests_zumba_dance_charles_cache_fur.abc', 'Z:/OEUF/CACHE/tests/zumba_dance/Charles/tests_zumba_dance_charles_cache_plumes.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_a_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_b_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_c_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_d_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_e_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_f_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_g_1.abc', 'Z:/OEUF/assets/characters/Bird/modeling/main/Houdini/export/feather_general_h_1.abc']\n\nfor path in paths:\n    name = os.path.basename(path)\n\n    with guerilla.Modifier() as mod:\n        mod.createref(name, path, options={ 'prefixnodes' : False,'containschildren' : True })\n\nguerilla.Document().save()\n\n# Script 2\n\npaths = ['Z:/OEUF/assets/characters/Bird/shading/main/_EXPORT/RG_shading_Bird_charles.grendergraph', 'Z:/OEUF/UTILS/HDRIS/sky_midday_rg.grendergraph']\n\nfor path in paths:\n    name = os.path.basename(path)\n\n    loaded = guerilla.Document().loadfile(path)\n\n    if not loaded:\n        BoltLogWarning(\"Could not load {} in guerilla file\".format(name))\n\nguerilla.Document().save()\n",
