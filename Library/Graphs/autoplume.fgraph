      "opCode": "# BeginOp\n\nimport subprocess, os\n\nBoltLogMessage(f\"Hython : Start executing script : {inscript}\")\n\ncommand = [\"hython\"]\n\nif os.path.exists(inhoufile):\n    command.append(inhoufile)\n\ncommand.append(inscript)\n\nBoltLogMessage(f\"Hython Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    BoltLogError(stderrAsStr)\nelse:\n    BoltLogMessage(f\"Hython : Finished executing script : {inscript}\")\n    BoltLogMessage(stdoutAsStr)\n\n\n\n",
