      "iconPath": "$BOLT_ICONS/guerilla-render.png",
      "definitionPath": "D:/dev/Bolt/Library/Nodes/guerilla_load_rendergraphs.fnode",
      "nodeType": "Guerilla/Guerilla_LoadRenderGraphs",
      "opCode": "# BeginOp\n\n# BeginOp\n\n# BeginOp\n\nif type(inrgfiles) is str:\n    inabcfiles = [inrgfiles]\nelse:\n    inabcfiles = inrgfiles\n\ngeneratedScript = f\"\"\"import guerilla, os\n\npaths = {inabcfiles}\n\nfor path in paths:\n    name = os.path.basename(path)\n\n    loaded = guerilla.Document().loadfile(path)\n\n    if not loaded:\n        BoltLogWarning(\"Could not load {{}} in guerilla file\".format(name))\n\nguerilla.Document().save()\n\"\"\"\n\ntmpScriptFilePath = BoltTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\noutscripttext = generatedScript\n\n\n\n",
