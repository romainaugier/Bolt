      "iconPath": "$BOLT_ICONS/guerilla-render.png",
      "definitionPath": "D:/dev/Bolt/Library/Nodes/guerilla_create_scene.fnode",
      "nodeType": "Guerilla/Guerilla_CreateScene",
      "opCode": "# BeginOp\n\n# BeginOp\n\nimport os\n\nif os.path.exists(infilepath):\n    os.remove(infilepath)\n\ndir = os.path.dirname(infilepath)\n\nif not os.path.exists(dir):\n    os.makedirs(dir)\n\ngeneratedScript = f\"\"\"import guerilla\n\nimport RomanoTools.Guerilla.Utils as utils\n\nutils.SetOptims()\nutils.SetRange(\"{inframerange[0]}-{inframerange[1]}\")\n\nrenderPass = guerilla.Document().findchild(\"RenderPass\")\n\nrenderPass.FileLayerName.set(\"$o_$n\")\n\nguerilla.Document().ProjectWidth.set(2048)\nguerilla.Document().ProjectHeight.set(858)\n\nguerilla.Document().save(\"{infilepath}\")\n\"\"\"\n\ntmpScriptFilePath = BoltTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\noutscripttext = generatedScript\n\n\n",
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
      "inputs": {
        "infilepath": [
          {
            "shortName": "infilepath",
