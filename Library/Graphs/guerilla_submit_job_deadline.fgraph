            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": "D:/dev/Bolt/Library/Templates/Nuke/generate_daily.nk",
            "defaultData": "",
            "type": 7,
            "connectionName": "outfile",
            "connectionNodeId": "3166343236343762313536316632383534366639353163656333333533323266"
          }
        ]
      },
