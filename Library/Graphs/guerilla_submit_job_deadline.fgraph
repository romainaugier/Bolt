    {
      "name": "NK_NukePy",
      "category": "Nuke",
      "id": "6662343739336334633030323366663731666335353563333236636639613364",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/nuke.png",
      "definitionPath": "",
      "opCode": "# BeginOp\n\nimport subprocess, os\n\nBoltLogMessage(f\"NukeBatch : Start executing script : {inscriptfile}\")\n\ncommand = [f\"{innukebindir}\", \"-t\", inscriptfile]\n\nfor arg in inargs:\n    command.append(arg)\n\nBoltLogMessage(f\"NukeBatch Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE)\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    BoltLogError(stderrAsStr)\nelse:\n    BoltLogMessage(f\"NukeBatch : Finished executing script\")\n    BoltLogMessage(stdoutAsStr)\n\n    for line in stdoutAsStr.splitlines():\n        if line.startswith(\"OUTPUTFILE\"):\n            outfile = line.split(\"=\")[1].strip()\n\n",
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
      "inputs": {
        "inscriptfile": [
          {
            "shortName": "inscriptfile",
            "longName": "Script File",
            "index": 0,
            "isExposed": false,
            "isHidden": false,
            "isExposedToGraph": false,
            "data": "C:\\Users\\r.augier\\AppData\\Roaming\\Bolt/3331663363353932363232633930323166396463636133343236666433663364.py",
            "defaultData": "",
            "type": 7,
            "connectionName": "outscriptfile",
            "connectionNodeId": "6336323537383938393239373866623439653262626131636562663831376535"
          }
        ],
        "inargs": [
          {
