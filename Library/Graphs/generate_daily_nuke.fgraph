    {
      "name": "NK_NukePy",
      "category": "Nuke",
      "id": "3166383330353636316562353065323339306331333466343731613133626133",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$FLASH_ICONS/nuke.png",
      "definitionPath": "D:/dev/FLash/Library/Nodes/nk_nukepy.fnode",
      "nodeType": "Nuke/NK_NukePy",
      "opCode": "\n# BeginOp\n\nimport subprocess, os\n\nFlashLogMessage(f\"NukeBatch : Start executing script : {inscriptfile}\")\n\ncommand = [f\"{innukebindir}\", \"-t\", inscriptfile]\n\nfor arg in inargs:\n    command.append(arg)\n\nFlashLogMessage(f\"NukeBatch Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, encoding=\"utf-8\")\nstdout, stderr = process.communicate()\n\ntry:\n    stdoutAsStr = stdout\n    stderrAsStr = stderr\n\n    if len(stderrAsStr) > 0:\n        FlashLogError(stderrAsStr)\n    else:\n        FlashLogMessage(f\"NukeBatch : Finished executing script\")\n        FlashLogMessage(stdoutAsStr)\n\n        for line in stdoutAsStr.splitlines():\n            if line.startswith(\"OUTPUTFILE\"):\n                outfile = line.split(\"=\")[1].strip()\nexcept Exception as e:\n    FlashLogMessage(e)\n\n",
      "disabled": false,
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
