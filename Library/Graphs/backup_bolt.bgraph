    {
      "name": "Backup_Directory1",
      "category": "Utility",
      "id": "3662393931346539663263393835343735316137656634646236333433373831",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/util.png",
      "definitionPath": "$BOLT_LIB/Nodes/backup_directory.bnode",
      "nodeType": "Utility/Backup_Directory",
      "opCode": "\nimport os, subprocess, multiprocessing\n\ncommand = [\"robocopy\", indirtobackup, inbackupdir]\n\nif inenablefilters:\n    for filter in infilefilters:\n        fileFilter = f\"*.{filter}\"\n        command.append(fileFilter)\n\noptions = [\"/s\", \"/j\", f\"/MT:{multiprocessing.cpu_count()}\", \"/NS\", \"/NC\", \"/IT\"]\n\nfor option in options:\n    command.append(option)\n\nBoltLogMessage(\"Starting backup\")\nBoltLogMessage(f\"Command : {' '.join(command)}\")\n\nprocess = subprocess.Popen(command, shell=False, stdout=subprocess.PIPE, encoding=\"ISO-8859-1\")\n\nwhile True:\n    output = process.stdout.readline()\n\n    if process.poll() is not None:\n        break\n    if output:\n        print(output.strip())\n\nBoltLogMessage(\"Finished backup\")\n\n",
      "disabled": false,
