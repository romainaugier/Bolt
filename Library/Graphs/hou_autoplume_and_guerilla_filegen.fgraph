    {
      "name": "Hou_AutoPlume",
      "id": "3834313762356538326665333930356230393763316534313339376536366139",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$FLASH_ICONS/houdini.png",
      "opCode": "# BeginOp\n\ngeneratedScript = f\"\"\"import hou\n\nanimSopNode = None\nplumeSopNode = None\n\nfor node in hou.node(\"/obj\").children():\n    if node.name() == \"anim_import\":\n        animSopNode = node\n    elif node.name() == \"plume\":\n        plumeSopNode = node\n\nif animSopNode != None:\n    for node in animSopNode.children():\n        if node.type().name() == \"alembic\":\n            node.parm(\"fileName\").set(\"{inanimationabcfile}\")\n            break\n\nif plumeSopNode != None:\n    for node in plumeSopNode.children():\n        if node.type().name() == \"rop_alembic\":\n            node.parm(\"filename\").set(\"{inoutputfilename}\")\n            node.parm(\"f1\").set({framerange[0]})\n            node.parm(\"f2\").set({framerange[1]})\n            node.parm(\"execute\").pressButton()\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\n\n",
      "inputs": {
        "inanimationabcfile": [
