      "iconPath": "$FLASH_ICONS/guerilla-render.png",
      "opCode": "# BeginOp\n\ngeneratedScript = f\"\"\"import guerilla, os\n\nprint(\"test\")\n\npath = \"{inabcfile}\"\n\nname = os.path.basename(path)\n\nwith guerilla.Modifier() as mod:\n\tmod.createref(name, path, options={{'prefixnodes':False,'containschildren':True}})\n\nguerilla.Document().save()\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\n\n",
