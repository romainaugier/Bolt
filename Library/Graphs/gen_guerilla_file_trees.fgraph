    {
      "name": "Guerilla_StartGuerilla",
      "id": "3662633031323461373736396132343233643435633838366163663638336562",
      "color": [
        52,
        115,
        165
      ],
      "iconPath": "$FLASH_ICONS/guerilla-render.png",
      "opCode": "# BeginOp\n\nimport subprocess, os\n\nFlashLogMessage(f\"Guerilla : Start session\")\n\ncommand = [f\"{inenvironment['GUERILLA']}/guerilla\"] \n\nif os.path.exists(inguerillafile):\n    FlashLogMessage(f\"Guerilla : File : {inguerillafile}\")\n    command.append(inguerillafile)\n\nif os.path.exists(inscript):\n    FlashLogMessage(f\"Guerilla : Script : {inscript}\")\n    command.append(inscript)\n\nFlashLogMessage(f\"Guerilla Command : {' '.join(command)}\")\n\nenv = os.environ.copy()\nenv.update(inenvironment)\n\nprocess = subprocess.Popen(command, stdout = subprocess.PIPE, stderr = subprocess.PIPE, env=env)\n\nstdout, stderr = process.communicate()\n\nstdoutAsStr = stdout.decode(\"utf-8\")\nstderrAsStr = stderr.decode(\"utf-8\")\n\nif len(stderrAsStr) > 0:\n    FlashLogError(stderrAsStr)\nelse:\n    FlashLogMessage(f\"Guerilla : Finished session\")\n    FlashLogMessage(stdoutAsStr)\n\n",
      "inputs": {
