      "iconPath": "$FLASH_ICONS/guerilla-render.png",
      "opCode": "# BeginOp\n\nimport os\n\nif os.path.exists(infilepath):\n    os.remove(infilepath)\n\ngeneratedScript = f\"\"\"import guerilla\n\nimport RomanoTools.Guerilla.Utils as utils\n\nutils.SetOptims()\nutils.SetRange(\"{inframerange[0]}-{inframerange[1]}\")\n\nrenderPass = guerilla.Document().findchild(\"RenderPass\")\n\nrenderPass.FileLayerName.set(\"$o_$n\")\n\nguerilla.Document().ProjectWidth.set(2048)\nguerilla.Document().ProjectHeight.set(858)\n\nguerilla.Document().save(\"{infilepath}\")\n\"\"\"\n\ntmpScriptFilePath = FlashTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as scriptFile:\n    scriptFile.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\noutscripttext = generatedScript\n\n",
      "inputs": {
