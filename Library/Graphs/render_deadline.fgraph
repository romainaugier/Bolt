    {
      "name": "NK_GenerateDaily",
      "category": "Nuke",
      "id": "3265333734303566373232313061336632653334653732386233303464626532",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/nuke.png",
      "definitionPath": "C:/Users/augie/Documents/Bolt/Library/Nodes/nk_generatedaily.fnode",
      "nodeType": "Nuke/NK_GenerateDaily",
      "opCode": "# BeginOp\n\ngeneratedScript = f\"\"\"import nuke, os, sys\n\nnuke.scriptOpen(\"{innuketemplate}\")\n\nseqs = nuke.getFileNameList(\"{inrenderdir}\")\n\noutputfile = \"{inrenderdir}/daily/daily.mov\"\n\nif len(seqs) > 0:\n    if not os.path.exists(outputfile):\n        os.makedirs(os.path.dirname(outputfile))\n\n    read = nuke.toNode(\"MAIN_READ\")\n    read.knob(\"file\").fromUserText(\"{inrenderdir}/\" + seqs[0])\n\n    write = nuke.toNode(\"MAIN_WRITE\")\n    write.knob(\"file\").fromUserText(outputfile)\n\n    first = int(read.knob(\"first\").getValue())\n    last = int(read.knob(\"last\").getValue())\n\n    nuke.execute(\"MAIN_WRITE\", start=first, end=last, incr=1)\n\nelse:\n    sys.stderr.write(\"[ERROR] Nk_GenerateDaily : No file sequence found\")\n\n\"\"\"\n\ntmpScriptFilePath = BoltTempScript()\n\nwith open(tmpScriptFilePath, \"w\") as file:\n    file.write(generatedScript)\n\noutscriptfile = tmpScriptFilePath\n\n",
      "disabled": false,
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
      "inputs": {
