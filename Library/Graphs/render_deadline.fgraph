    {
      "name": "Deadline_WaitForJobFinished",
      "category": "Deadline",
      "id": "6634663037373936643765373665306365653730623838646165366565633664",
      "color": [
        0,
        0,
        0
      ],
      "iconPath": "$BOLT_ICONS/deadlinelogo.png",
      "definitionPath": "C:/Users/augie/Documents/Bolt/Library/Nodes/deadline_wait_for_job.fnode",
      "nodeType": "Deadline/Deadline_WaitForJobFinished",
      "opCode": "# BeginOp\n\nimport subprocess, time\n\nBoltLogMessage(f\"Deadline : Waiting for job {injobid}\")\n\njobIsNotComplete = True\n\nwhile jobIsNotComplete:\n\n    process = subprocess.Popen([\"deadlinecommand\", \"-GetJob\", injobid], stdout = subprocess.PIPE, stderr = subprocess.PIPE)\n    stdout, stderr = process.communicate()\n\n    stdoutAsStr = stdout.decode(\"utf-8\")\n    stderrAsStr = stderr.decode(\"utf-8\")\n\n    for line in stdoutAsStr.splitlines():\n        if line.startswith(\"JobStatus\"):\n            jobStatus = line.split(\"=\")[1]\n\n            if jobStatus == \"Completed\":\n                jobIsNotComplete = False\n                outjobcomplete = True\n                BoltLogMessage(f\"Deadline : Job {injobid} is complete\")\n                break\n            elif jobStatus == \"Failed\":\n                jobIsNotComplete = False\n                outjobcomplete = False\n                BoltLogWarning(f\"Deadline : Job {injobid} is failed\")\n                break\n            else:\n                time.sleep(60)\n                break\n\n",
      "disabled": false,
      "isIfBegin": false,
      "associatedEndBlockId": null,
      "isIfEnd": false,
      "associatedBeginBlockId": null,
      "inputs": {
